#define name ENERGÉTICO
#define color teal
#define glyph camera
#define inputs image, file, pdf, media
#define from sharesheet
#define version 26

#include 'actions/web'

#question credential "Cole a credencial copiada pelo portal Energético." ""

nothing()
const token = text(credential)

if ShortcutInput {
    for sharedItem in ShortcutInput {
        const fileName = getName(@sharedItem)
        const encodedName = urlEncode(fileName)

        rawAction("is.workflow.actions.downloadurl", {
            "WFURL": "https://163-176-171-217.sslip.io/api/shortcut-upload",
            "WFHTTPMethod": "POST",
            "WFHTTPHeaders": {
                "Authorization": "Bearer {token}",
                "Content-Type": "application/octet-stream",
                "X-Portal-File-Name": "${encodedName}"
            },
            "WFHTTPBodyType": "File",
            "WFRequestVariable": "${@sharedItem}"
        })
    }
}

openURL("https://www.energeticabr.com/energetico/")
