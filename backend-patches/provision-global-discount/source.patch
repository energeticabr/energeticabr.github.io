+def provision_money(value):
+    """Totals are BRL amounts; unit prices retain their numeric precision."""
+    with localcontext() as context:
+        context.prec = max(50, value.adjusted() + 4)
+        return value.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+
+
+def restore_provision_discount(lines):
+    restored = copy.deepcopy(lines)
+    for line in restored:
+        adjustment = line.pop("provision_discount_adjustment", None)
+        if not adjustment:
+            continue
+        fields = line.setdefault("fields", {})
+        if _number(fields.get("VALOR TOTAL"), "VALOR TOTAL") != _number(
+                adjustment["adjusted_unit_value"], "VALOR TOTAL"):
+            # An explicit price edit is already a new original, never overwrite it.
+            continue
+        fields["VALOR TOTAL"] = adjustment["original_unit_value"]
+        display = line.setdefault("display_values", {})
+        if adjustment["display_present"]:
+            display["VALOR TOTAL"] = adjustment["original_unit_display"]
+        else:
+            display.pop("VALOR TOTAL", None)
+        answers = line.setdefault("answers", {})
+        if adjustment["answer_present"]:
+            answers["valor_unitario_pagamento"] = adjustment["original_unit_answer"]
+        else:
+            answers.pop("valor_unitario_pagamento", None)
+    return restored
+
+
+def apply_provision_discount(lines, raw_discount):
+    """A common unit-price factor, excluding freight, at SharePoint precision.
+
+    Return new snapshots only after validating the entire calculation. Never
+    round each unit to cents: quantities can require fractional unit prices.
+    """
+    original = restore_provision_discount(lines)
+    discount = _number(raw_discount, "DESCONTO GLOBAL", positive=True)
+    if discount != provision_money(discount):
+        raise ValueError("Informe o desconto em reais, com no máximo duas casas decimais")
+    amounts = [_amounts(line.get("fields") or {}) for line in original]
+    with localcontext() as context:
+        context.prec = 60
+        products = _sum(quantity * unit for quantity, unit, _ in amounts)
+        gross = _sum(_line_total(*values) for values in amounts)
+        if discount > products or products <= 0:
+            raise ValueError("O desconto não pode exceder o valor total dos produtos, sem o frete")
+        factor = (products - discount) / products
+        result = copy.deepcopy(original)
+        for line, (quantity, unit, freight) in zip(result, amounts):
+            # Number/Currency fields cross the same IEEE-754 boundary in clients.py.
+            adjusted = _number(Decimal(str(float(unit * factor))), "VALOR TOTAL")
+            fields, display, answers = (line.setdefault(key, {})
+                                        for key in ("fields", "display_values", "answers"))
+            line["provision_discount_adjustment"] = {
+                "original_unit_value": _canonical(unit),
+                "adjusted_unit_value": _canonical(adjusted),
+                "display_present": "VALOR TOTAL" in display,
+                "original_unit_display": display.get("VALOR TOTAL"),
+                "answer_present": "valor_unitario_pagamento" in answers,
+                "original_unit_answer": answers.get("valor_unitario_pagamento"),
+            }
+            fields["VALOR TOTAL"] = _canonical(adjusted)
+            display["VALOR TOTAL"] = _currency(adjusted)
+            answers["valor_unitario_pagamento"] = _canonical(adjusted)
+        net = provision_money(gross - discount)
+        actual = provision_money(_sum(
+            _line_total(
+                _number(Decimal(str(float(quantity))), "QTD", positive=True),
+                _number(line["fields"]["VALOR TOTAL"], "VALOR TOTAL"),
+                _number(Decimal(str(float(freight))), "FRETE"),
+            )
+            for line, (quantity, _unit, freight) in zip(result, amounts)
+        ))
+        preview_total = provision_money(_sum(provision_line_total(line["fields"]) for line in result))
+        if actual != net or preview_total != net:
+            raise ValueError("Não foi possível representar esse desconto com a precisão dos valores unitários")
+        return result, {
+            "enabled": True, "decision_complete": True,
+            "amount": _canonical(discount), "percentage": _canonical(discount * 100 / products),
+            "original_total": _canonical(provision_money(gross)), "net_total": _canonical(net),
+        }
