+    def _provision_discount_eligible(self, state):
+        return (self._provision_multiple(state) and len(state.get("provision_lines") or []) > 1
+                and not state.get("provision_commit") and state.get("stage") not in {"notifying", "completed"})
+
+    def _provision_discount_identity(self, state):
+        metadata = state.get("provision_discount") or {}
+        payload = [metadata.get("enabled"), metadata.get("amount"),
+                   [line.get("fields", {}) for line in state.get("provision_lines", [])]]
+        return hashlib.sha256(json.dumps(payload, sort_keys=True, ensure_ascii=False).encode()).hexdigest()
+
+    def _provision_sync_discount_current(self, state):
+        if not state.get("provision_current_saved") or not state.get("provision_lines"):
+            return
+        last = state["provision_lines"][-1]
+        for bucket, key in (("fields", "VALOR TOTAL"), ("display_values", "VALOR TOTAL"),
+                            ("answers", "valor_unitario_pagamento")):
+            destination = state.setdefault(bucket, {})
+            if key in last.get(bucket, {}):
+                destination[key] = copy.deepcopy(last[bucket][key])
+            else:
+                destination.pop(key, None)
+
+    def _provision_prepare_discount_edit(self, state):
+        if self._provision_discount_eligible(state):
+            state["provision_lines"] = restore_provision_discount(state["provision_lines"])
+            self._provision_sync_discount_current(state)
+
+    def _provision_discount_before_review(self, state, etag):
+        if not self._provision_discount_eligible(state):
+            return None
+        self._provision_first_freight_only(state)
+        metadata = state.get("provision_discount") or {}
+        if not metadata.get("decision_complete"):
+            return self._prompt_provision_question(state, etag, "asking_provision_discount")
+        if metadata.get("enabled"):
+            try:
+                lines, updated = apply_provision_discount(state["provision_lines"], metadata["amount"])
+            except ValueError as exc:
+                self._send_text(state, str(exc))
+                self._provision_prepare_discount_edit(state)
+                return self._prompt_provision_question(state, etag, "entering_provision_discount")
+            updated["review_identity"] = metadata.get("review_identity")
+            state["provision_lines"], state["provision_discount"] = lines, updated
+            self._provision_sync_discount_current(state)
+        return None
+
+    def _provision_discount_before_commit(self, state, etag):
+        if not self._provision_discount_eligible(state):
+            return None
+        pending = self._provision_discount_before_review(state, etag)
+        if pending is not None:
+            return pending
+        metadata = state.get("provision_discount") or {}
+        if metadata.get("enabled") and metadata.get("review_identity") != self._provision_discount_identity(state):
+            self._send_text(state, "CONFIRA A PRÉVIA ATUALIZADA DO DESCONTO ANTES DE CONFIRMAR.")
+            return self._summarize_and_confirm(state, etag)
+        return None
+
