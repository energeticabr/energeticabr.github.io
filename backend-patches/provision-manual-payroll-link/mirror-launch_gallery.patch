+    def _check_provision_payroll_origin(self, provision_id, launch_id):
+        rows = self._pending_payroll_rows(launch_id)
+        if rows:
+            if len(rows) == 1 and rows[0].get("Title") == f"APP-folha-provisao-{provision_id}":
+                return
+            _fail("payroll_allocation_locked", "O lançamento já está vinculado em outra linha da folha.", 409)
+        if __package__:
+            from .payroll_pending import assert_legacy_origin_available
+        else:
+            from payroll_pending import assert_legacy_origin_available
+        assert_legacy_origin_available(self, launch_id)
+
+    def _confirm_provision_payroll_link(self, payload):
+        ids = ("provisionId", "launchId")
+        check_only = payload.get("checkOnly") is True
+        if set(payload) != (set(ids) | {"checkOnly"} if check_only else set(ids)):
+            _fail("invalid_payload", "Informe a provisão e o lançamento.")
+        provision_id, launch_id = (_id(payload[key]) for key in ids)
+        provision = self._get("PROVISÃO PGTOS", provision_id,
+                              ("IDFOLHA", "FORNECEDOR", "TIPOPGTO", "IDLANCAMENTOS", "FILIAL"))
+        launch = self._get(LAUNCHES, launch_id, ("FORNECEDOR", "IDPGTOAGENDADO", "DATA PGTO EFETUADO", "FILIAL"))
+
+        def branch(value):
+            text = str(value or "").strip()
+            code = re.match(r"^\d+(?=\s*(?:-|$))", text)
+            return code.group(0) if code else _norm(text)
+
+        sheet = provision.get("IDFOLHA")
+        supplier, rubric = provision.get("FORNECEDOR"), provision.get("TIPOPGTO")
+        linked_launch = str(provision.get("IDLANCAMENTOS") or "").strip()
+        linked_provision = str(launch.get("IDPGTOAGENDADO") or "").strip()
+        valid_launches = ("", launch_id) if check_only else (launch_id,)
+        valid_provisions = ("", provision_id) if check_only else (provision_id,)
+        paid_date = launch.get("DATA PGTO EFETUADO")
+        if (not isinstance(sheet, (int, float)) or isinstance(sheet, bool) or sheet <= 0
+                or not float(sheet).is_integer()
+                or not _norm(supplier or "") or not _norm(rubric or "")
+                or _norm(supplier or "") != _norm(launch.get("FORNECEDOR") or "")
+                or not branch(provision.get("FILIAL")) or branch(provision.get("FILIAL")) != branch(launch.get("FILIAL"))
+                or linked_launch not in valid_launches or linked_provision not in valid_provisions
+                or not paid_date or not _instant(paid_date)):
+            _fail("payroll_provision_mismatch", "O lançamento pago e a provisão da folha não conferem.", 409)
+        try:
+            linked = self.engine._settlement_has_payroll_link(
+                int(provision_id), launch_id=int(launch_id), expected_payroll=(int(sheet), supplier, rubric),
+                check_only=check_only)
+        except LaunchGalleryError:
+            raise
+        except ValueError:
+            _fail("payroll_provision_mismatch", "O vínculo da folha mudou. Confira a provisão e retome a baixa.", 409)
+        if not linked:
+            _fail("payroll_provision_mismatch", "A folha não confirmou o pagamento desta provisão. Confira o vínculo e retome a baixa.", 409)
+        if check_only:
+            self._check_provision_payroll_origin(provision_id, launch_id)
+        return {"ready" if check_only else "linked": True, "provisionId": provision_id, "launchId": launch_id}
+
     def _handle(self, operation, payload):
