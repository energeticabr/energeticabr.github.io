@@ -0,0 +1,99 @@
+"""Read-only append eligibility and exact totals, separate from settlement rules."""
+from __future__ import annotations
+
+import copy
+import re
+
+try:
+    from .payment_provision_group import _canonical, _currency, _number, _sum, provision_line_total
+except ImportError:
+    from payment_provision_group import _canonical, _currency, _number, _sum, provision_line_total
+
+
+PARENT_LIST = "DESCRITIVOPROVISAO"
+PAYMENT_MARKERS = ("DATAPGTOEFETUADO", "PGTOAGENDADO", "DATAPGTOAGENDADO", "DATAEXECUCAOAGENDAMENTO")
+PARENT_FIELDS = ("FORNECEDOR", "FILIAL", "OBS", "FORMAPGTO", "DATAPREVISTOPGTO",
+                 "VALORTOTAL", *PAYMENT_MARKERS)
+
+
+class ParentUnavailable(ValueError):
+    pass
+
+
+def parent_id(value):
+    if isinstance(value, bool) or not isinstance(value, (int, str)):
+        raise ValueError("ID positivo do descritivo é obrigatório")
+    text = str(value).strip()
+    if not re.fullmatch(r"[1-9][0-9]*", text):
+        raise ValueError("ID positivo do descritivo é obrigatório")
+    return text
+
+
+def read_parent(client, item_id):
+    item_id = parent_id(item_id)
+    fields, etag = client.get_item_fields_with_etag(int(item_id), PARENT_FIELDS, target_list=PARENT_LIST)
+    if not isinstance(fields, dict) or any(key not in fields for key in PARENT_FIELDS):
+        raise ValueError("Leitura incompleta do descritivo")
+    if not isinstance(etag, str) or not etag.strip() or etag.strip() == "*":
+        raise ValueError("ETag específico do descritivo é obrigatório")
+    if any(value is not None and (not isinstance(value, str) or value.strip())
+           for value in (fields[key] for key in PAYMENT_MARKERS)):
+        raise ParentUnavailable("O descritivo já está pago, agendado ou em execução")
+    return {"parent_id": item_id, "fields": copy.deepcopy(fields), "etag": etag.strip()}
+
+
+def validate_parent(client, selection, *, check_etag=True, allow_total_change=False):
+    current = read_parent(client, selection["parent_id"])
+    expected = selection["fields"]
+    keys = [key for key in PARENT_FIELDS if not (allow_total_change and key == "VALORTOTAL")]
+    if any(current["fields"][key] != expected.get(key) for key in keys):
+        raise ParentUnavailable("O descritivo escolhido foi alterado; revise a seleção")
+    if check_etag and current["etag"] != selection.get("etag"):
+        raise ParentUnavailable("A versão do descritivo escolhido foi alterada; revise a seleção")
+    return current
+
+
+def linked_total(group, item_id, required_child_ids=()):
+    item_id = parent_id(item_id)
+    if parent_id(group["Id"]) != item_id:
+        raise ValueError("A consulta retornou outro descritivo")
+    children = group.get("CHILDREN")
+    if not isinstance(children, list) or not children:
+        raise ValueError("Total desconhecido: filhos do descritivo ausentes")
+    seen, totals = set(), []
+    for child in children:
+        child_id = parent_id(child["Id"])
+        if child_id in seen or child.get("DESCRITIVOPROVISAO") != item_id:
+            raise ValueError("Filhos duplicados ou com vínculo conflitante")
+        seen.add(child_id)
+        fields = dict(child)
+        if fields.get("FRETE") is None or (isinstance(fields.get("FRETE"), str) and not fields["FRETE"].strip()):
+            fields["FRETE"] = "0"
+        totals.append(provision_line_total(fields))
+    if not {parent_id(value) for value in required_child_ids}.issubset(seen):
+        raise ValueError("A consulta ainda não confirmou todos os filhos gravados")
+    return _canonical(_sum(totals))
+
+
+def same_total(raw, expected):
+    return _number(raw, "VALORTOTAL") == _number(expected, "VALORTOTAL")
+
+
+def append_options(client):
+    options = []
+    for group in client.get_pending_provision_descriptions():
+        if group.get("settlementBlocked"):
+            continue
+        try:
+            selection = read_parent(client, group["Id"])
+        except ParentUnavailable:
+            continue
+        fields = selection["fields"]
+        total = linked_total(group, selection["parent_id"])
+        options.append({"id": selection["parent_id"], "value": selection["parent_id"],
+                        "title": f"DESCRITIVO {selection['parent_id']} · {fields['FORNECEDOR']} · "
+                                 f"FILIAL {fields['FILIAL']} · {fields['DATAPREVISTOPGTO']} · "
+                                 f"{_currency(_number(total, 'VALORTOTAL'))}",
+                        "source_values": selection})
+    options.append({"id": "provision_parent_new", "value": "NEW", "title": "NOVO DESCRITIVO"})
+    return options
