+    def _schedule_post_completion_menu(self, state: dict) -> None:
+        delay_seconds = max(
+            0,
+            int(
+                self.config.get("limits", {}).get(
+                    "post_completion_menu_delay_seconds", 10
+                )
+            ),
+        )
+        try:
+            self.messenger.schedule_deferred(
+                state,
+                {
+                    "kind": "post_completion_menu",
+                    "conversation_key": state["key"],
+                    "batch_id": state["batch_id"],
+                    "completion_id": state["completion_id"],
+                },
+                delay_seconds,
+            )
+        except Exception:
+            # O registro concluído e o marcador de agendamento já foram
+            # persistidos. Uma indisponibilidade do canal ao enfileirar o
+            # menu não pode transformar a submissão em falha nem provocar
+            # a repetição da gravação no SharePoint.
+            pass
