+            owner = tuple(_text(fields.get(key)) for key in ('FILIAL', 'FORNECEDOR'))
+            if not all(owner) or any(_text(fields.get(key)) != _text(original[ident].get(key))
+                                     for key in ('FILIAL', 'FORNECEDOR')):
+                raise RuntimeError('Fornecedor ou filial da provisão mudou. Revise o descritivo antes de baixar.')
+            partitions.setdefault(tuple(part.casefold() for part in owner), []).append(entry)
+        common = _common(group['common'])
+        plans = []
+        for owner, entries in partitions.items():
+            fields = entries[0]['fields']
+            total = _sum(provision_line_total({**e['fields'], 'FRETE': e['fields'].get('FRETE') or '0'})
+                         for e in entries)
+            order = {'FILIAL': fields['FILIAL'], 'FORNECEDOR': fields['FORNECEDOR'],
+                     'VALORTOTAL': _canonical(total), 'DATA PEDIDO': common['DATA PGTO EFETUADO'],
+                     'STATUS': 'PENDENTE AUDITORIA', 'FORMAPGTO': common['FORMAPGTO'], 'NOTA FISCAL': 'PENDENTE'}
+            if common['OBS']:
+                order['OBS'] = common['OBS']
+            token = f"WA-BAIXA-PEDIDO-DESCRITIVO-{group['parent_id']}"
+            if len(partitions) > 1:
+                # Length-prefixing prevents ambiguous concatenations of owner names.
+                identity = ''.join(f'{len(part)}:{part}' for part in owner)
+                token += '-GRUPO-' + hashlib.sha256(identity.encode('utf-8')).hexdigest()
+            plans.append({'token': token, 'fields': order,
+                          'children': [str(e['fields']['ID PROVISÃO']) for e in entries]})
+        return plans
+
