 OWNER = ('FORNECEDOR', 'FILIAL')
 FIELDS = (*OWNER, 'DESCRITIVOPROVISAO', 'IDPEDIDO', 'IDLANCAMENTOS')
+
+
+def _scope_path(directory, parent):
+    return Path(directory) / 'settlement-owners' / f'parent-{mirror.item_id(parent)}.json'
+
+
+def _load_scope(directory, parent, owner):
+    path = _scope_path(directory, parent)
+    try:
+        fd = os.open(str(path), os.O_RDONLY | os.O_NOFOLLOW)
+    except FileNotFoundError:
+        return None
+    with os.fdopen(fd, 'r') as stream:
+        info = os.fstat(stream.fileno())
+        if not stat.S_ISREG(info.st_mode) or info.st_size > 10_000_000 or info.st_mode & 0o022:
+            raise RuntimeError('Contexto privado de anexos inválido.')
+        scope = json.load(stream)
+    if (not isinstance(scope, dict) or set(scope) != {'parent', 'owner', 'rows'}
+            or scope['parent'] != parent or scope['owner'] != owner
+            or not isinstance(scope['rows'], dict) or not scope['rows']):
+        raise RuntimeError('O descritivo mudou desde a confirmação dos anexos.')
+    for ident, fields in scope['rows'].items():
+        if (str(mirror.item_id(ident)) != ident or not isinstance(fields, dict)
+                or set(fields) != set(OWNER) or any(not text(fields[k]) for k in OWNER)):
+            raise RuntimeError('Contexto de proprietários dos anexos inválido.')
+    return scope['rows']
+
+
+def _save_scope(directory, parent, snapshot):
+    path = _scope_path(directory, parent)
+    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+    scope = {'parent': parent, 'owner': snapshot['owner'],
+             'rows': {str(ident): {key: row[key] for key in OWNER}
+                      for ident, row in snapshot['rows'].items()}}
+    fd, temporary = tempfile.mkstemp(prefix='.owners-', dir=path.parent)
+    try:
+        with os.fdopen(fd, 'w') as stream:
+            json.dump(scope, stream, ensure_ascii=False, sort_keys=True)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, path)
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
 
 
