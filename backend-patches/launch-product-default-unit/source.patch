+    def _launch_product_unit_option(self, snapshot: dict) -> dict | None:
+        selection = (snapshot.get("selections") or {}).get("produto_lancamento") or {}
+        product_id = None
+        for raw in (selection.get("id"), (selection.get("source_values") or {}).get("Id")):
+            if isinstance(raw, (int, str)) and not isinstance(raw, bool):
+                if re.fullmatch(r"[0-9]+", str(raw).strip()) and int(raw) > 0:
+                    product_id = int(raw)
+                    break
+        if product_id is None:
+            return None
+        options = self.sharepoint.get_options({
+            "key": "unidade_padrao_produto_lancamento",
+            "source": {
+                "type": "sharepoint_list", "list": "CADASTROPRODUTO",
+                "id_field": "Id", "label_field": "UNIDADE", "value_field": "UNIDADE",
+                "fields": ["Id", "UNIDADE"],
+                "filters": [{"field": "Id", "equals": product_id}],
+            },
+        }, {})
+        if len(options) != 1 or str(options[0].get("id")) != str(product_id):
+            return None
+        value = options[0].get("value")
+        if not isinstance(value, str) or not value.strip():
+            return None
+        return {**options[0], "value": value.strip(), "title": value.strip(), "recommended": True}
+
