+            snapshot.setdefault("display_values", {})["UN"] = option["value"]
+            snapshot.setdefault("answers", {})["unidade_lancamento"] = option["value"]
+            snapshot.setdefault("selections", {})["unidade_lancamento"] = option
+        return None
