+    def _migrate_launch_payroll_sheet_entries(self, state: dict, pending: dict) -> None:
+        if "sheet_entry_index" in pending:
+            return
+        # A legacy POST may have succeeded before its verification/checkpoint.
+        # Reconcile by the existing token using reads only, before discarding
+        # any supplier-wide choices. Never merge or relink an existing payment.
+        for entry in pending.get("selected_entries") or []:
+            if entry.get("FOLHAPGTO_ID"):
+                continue
+            launch_id = int(str(entry.get("item_id")).strip())
+            token = f"WA-launch-payroll-{state['batch_id']}-{launch_id}"
+            existing = self.sharepoint._find_item(token, "FOLHAPGTO", "Title")
+            if not existing:
+                continue
+            payroll_item_id = int(existing["Id"])
+            actual = self.sharepoint.get_item_fields(
+                payroll_item_id, ["TIPOPGTO"], target_list="FOLHAPGTO"
+            )
+            selected_type = next(
+                (title for _, title in LAUNCH_PAYROLL_TYPE_OPTIONS
+                 if normalize_text(str(actual.get("TIPOPGTO") or "")) == normalize_text(title)),
+                None,
+            )
+            fields = entry.get("fields") or {}
+            sheet_id = int(str(entry.get("IDFOLHA")).strip())
+            unit_value = _parse_decimal(fields.get("VALOR UNITÁRIO"), allow_zero=True)
+            quantity = _parse_decimal(fields.get("QUANTIDADE"), allow_zero=True)
+            if (launch_id <= 0 or payroll_item_id <= 0 or sheet_id <= 0
+                    or selected_type is None or unit_value is None or quantity is None):
+                raise ValueError("Invalid legacy payroll reconciliation")
+            payroll_fields = {
+                "FORNECEDOR": str(fields.get("FORNECEDOR") or entry.get("supplier") or "").strip(),
+                "TIPOPGTO": selected_type,
+                "VALORUNITARIO": _decimal_storage(unit_value),
+                "QTD": _decimal_storage(quantity),
+                "DATA": str(fields.get("DATA") or "")[:10],
+                "IDFOLHA": sheet_id,
+                "IDLANCAMENTO": launch_id,
+            }
+            if not payroll_fields["FORNECEDOR"] or not payroll_fields["DATA"]:
+                raise ValueError("Missing legacy payroll reconciliation fields")
+            verification = self.sharepoint.verify_item(
+                payroll_item_id, payroll_fields, [], target_list="FOLHAPGTO"
+            )
+            entry["TIPOPGTO"] = selected_type
+            entry["FOLHAPGTO_ID"] = payroll_item_id
+            rows = state.setdefault("sharepoint", {}).setdefault("folhapgto_rows", [])
+            if not any(row.get("item_id") == payroll_item_id for row in rows):
+                rows.append({"item_id": payroll_item_id, "launch_item_id": launch_id,
+                             "fields": copy.deepcopy(payroll_fields), "verified": verification})
+            self._send_text(state, f"✅ O PAGAMENTO DO LANÇAMENTO {launch_id} JÁ FOI GRAVADO "
+                            f"NA FOLHA {sheet_id}. ESSE VÍNCULO FOI PRESERVADO.")
+        # Legacy supplier-wide choices must not become individual consent.
+        # Verified payments are checkpoints, never candidates for relinking.
+        for entry in pending.get("selected_entries") or []:
+            if not entry.get("FOLHAPGTO_ID"):
+                entry.pop("IDFOLHA", None)
+        pending["sheet_entry_index"] = 0
+        for key in ("sheet_suppliers", "sheet_supplier_index", "current_sheet_supplier",
+                    "current_sheet_launch_id", "current_sheet_option_key"):
+            pending.pop(key, None)
+
