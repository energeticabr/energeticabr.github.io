+    @staticmethod
+    def _supplier_key(value):
+        return unicodedata.normalize("NFC", str(value or "")).strip().casefold()
+
+    @staticmethod
+    def _payroll_month(value):
+        raw = str(value or "").strip()
+        match = re.fullmatch(r"(\d{1,2})[/-](\d{4})", raw)
+        if match:
+            month, year = map(int, match.groups())
+        else:
+            match = re.fullmatch(r"(\d{4})[/-](\d{1,2})(?:[/-]\d{1,2}(?:T.*)?)?", raw)
+            if not match:
+                return None
+            year, month = map(int, match.groups())
+        return (year, month) if year and 1 <= month <= 12 else None
+
+    def _payroll_transfer_plan(self, item_id, supplier, current):
+        line_fields = ("FORNECEDOR", "IDFOLHA", "IDLANCAMENTO")
+        sheet_fields = ("FORNECEDOR", "MESREFERENCIA", "STATUS")
+        # IDLANCAMENTO is indexed text in FOLHAPGTO. Reject schema drift rather
+        # than interpreting a failed/incorrect lookup as an unlinked launch.
+        link = self._field("FOLHAPGTO", "IDLANCAMENTO")
+        if link.get("TypeAsString") != "Text":
+            _fail("payroll_schema", "A coluna IDLANCAMENTO da folha mudou de formato.", 503)
+        linked = self._rows("FOLHAPGTO", ["IDLANCAMENTO"], f"{link['InternalName']} eq {_literal(item_id)}")
+        direct = current.get("IDFOLHA")
+        if not linked and _blank(direct):
+            return [], None
+        target_key, old_key = self._supplier_key(supplier), self._supplier_key(current.get("FORNECEDOR"))
+        if not target_key:
+            _fail("payroll_supplier_required", "Selecione o fornecedor que receberá o lançamento na folha.", 422)
+        for label in line_fields:
+            self._field("FOLHAPGTO", label)
+        for label in sheet_fields:
+            self._field("IDFOLHA", label)
+
+        def payroll_id(value):
+            if isinstance(value, float) and value.is_integer():
+                value = int(value)
+            return _id(str(value).strip())
+
+        sheets = {}
+
+        def destination(sheet_id, owner):
+            if sheet_id not in sheets:
+                sheets[sheet_id] = self._get("IDFOLHA", sheet_id, sheet_fields)
+            original = sheets[sheet_id]
+            month = self._payroll_month(original.get("MESREFERENCIA"))
+            if not month or not owner or self._supplier_key(original.get("FORNECEDOR")) != owner:
+                _fail("payroll_sheet_mismatch", "A folha de origem não corresponde ao fornecedor ou à competência do vínculo.", 422)
+            matches = [row for row in self._catalog("IDFOLHA", sheet_fields)
+                       if self._supplier_key(row.get("FORNECEDOR")) == target_key
+                       and self._payroll_month(row.get("MESREFERENCIA")) == month
+                       and self._supplier_key(row.get("STATUS")) in {"", "ativo"}]
+            reference = f"{month[1]:02d}/{month[0]}"
+            if len(matches) != 1:
+                message = (f"O novo fornecedor não tem folha disponível para {reference}."
+                           if not matches else f"O novo fornecedor tem mais de uma folha para {reference}.")
+                _fail("payroll_destination", message, 422)
+            target = payroll_id(matches[0]["ID"])
+            if target not in sheets:
+                sheets[target] = self._get("IDFOLHA", target, sheet_fields)
+            if any(sheets[target].get(key) != matches[0].get(key) for key in sheet_fields):
+                _fail("conflict", "A folha de destino mudou; atualize o lançamento e tente novamente.", 409)
+            return target
+
+        changes, targets = [], set()
+        for summary in linked:
+            line_id = payroll_id(summary["ID"])
+            line = self._get("FOLHAPGTO", line_id, line_fields)
+            owner = self._supplier_key(line.get("FORNECEDOR"))
+            if line.get("IDLANCAMENTO") != item_id or owner not in {old_key, target_key}:
+                _fail("payroll_link_mismatch", "O pagamento vinculado está em nome de outro fornecedor ou lançamento.", 422)
+            source = payroll_id(line.get("IDFOLHA"))
+            target = destination(source, owner)
+            targets.add(target)
+            if owner == target_key and source != target:
+                _fail("payroll_link_mismatch", "O pagamento já está em outra folha do novo fornecedor.", 422)
+            if source != target or line.get("FORNECEDOR") != supplier:
+                replacement = {"FORNECEDOR": supplier, "IDFOLHA": target}
+                self._etag(line)
+                self._body("FOLHAPGTO", replacement)
+                changes.append((line, replacement))
+
+        if not _blank(direct):
+            direct = payroll_id(direct)
+            if direct not in sheets:
+                sheets[direct] = self._get("IDFOLHA", direct, sheet_fields)
+            owner = self._supplier_key(sheets[direct].get("FORNECEDOR"))
+            if owner not in {old_key, target_key}:
+                _fail("payroll_sheet_mismatch", "O lançamento já aponta para a folha de outro fornecedor.", 422)
+            direct_target = destination(direct, owner)
+            if targets and direct_target not in targets:
+                _fail("payroll_sheet_mismatch", "As competências da folha e dos pagamentos vinculados não correspondem.", 422)
+            return changes, direct_target
+        return changes, next(iter(targets)) if len(targets) == 1 else None
+
+    def _merge_payroll_line(self, item, values):
+        return self.sharepoint._request("POST", self._item_endpoint("FOLHAPGTO", item["ID"]),
+            json=self._body("FOLHAPGTO", values), _return_response=True,
+            headers={"Content-Type": "application/json;odata=nometadata", "IF-MATCH": self._etag(item), "X-HTTP-Method": "MERGE"})
+
+    def _write_supplier_change(self, item_id, values, current):
+        changes, sheet_id = self._payroll_transfer_plan(item_id, values["FORNECEDOR"], current)
+        if sheet_id is not None:
+            meta = self._field(LAUNCHES, "IDFOLHA")
+            values["IDFOLHA"] = self._value(LAUNCHES, "IDFOLHA", sheet_id, meta, current, check_options=False)
+        if not changes:
+            return self._write(item_id, values, current)
+        self._body(LAUNCHES, values)  # Validate every write before moving the first payment.
+        applied = []
+        labels = ("IDLANCAMENTO", "FORNECEDOR", "IDFOLHA")
+
+        def uncertain(*, pending=False):
+            _fail("payroll_write_pending" if pending else "payroll_reassignment_unverified",
+                  "Não foi possível confirmar toda a troca na folha. Atualize o lançamento e confira o vínculo antes de tentar novamente.", 502)
+
+        def read_back(name, row_id, fields):
+            try:
+                return self._get(name, row_id, fields)
+            except (requests.Timeout, requests.ConnectionError):
+                return self._get(name, row_id, fields)  # Retry only the read, never the MERGE.
+
+        def conditional_write(write, load, matches, old_tag, on_ack=None):
+            """Only compensate definite rejections or acknowledged payroll writes."""
+            acknowledged = False
+            for attempt in range(2):
+                try:
+                    response = write()
+                    acknowledged = True
+                    if on_ack is None:
+                        return
+                    on_ack(response)
+                except requests.RequestException as exc:
+                    status = getattr(exc.response, "status_code", None)
+                    if attempt == 0 and status is not None and 400 <= status < 500 and status != 408:
+                        raise
+                try:
+                    actual = load()
+                except (requests.RequestException, LaunchGalleryError):
+                    uncertain(pending=not acknowledged)
+                if matches(actual):
+                    return
+                if acknowledged or actual.get("_etag") != old_tag:
+                    break
+                # An old read does not prove a timed-out write failed. Retrying
+                # with the original ETag lets only one request modify the item.
+            uncertain(pending=not acknowledged)
+
+        try:
+            for line, replacement in changes:
+                def record(response):
+                    tag = getattr(response, "headers", {}).get("ETag")
+                    # When MERGE omits ETag, accept a single version step only.
+                    previous = re.fullmatch(r'(W/)?"(\d+)"', line["_etag"])
+                    if not tag and previous:
+                        tag = f'{previous[1] or ""}"{int(previous[2]) + 1}"'
+                    applied.append((line, replacement, tag))
+
+                count = len(applied)
+                conditional_write(
+                    lambda: self._merge_payroll_line(line, replacement),
+                    lambda: read_back("FOLHAPGTO", str(line["ID"]), labels),
+                    lambda actual: actual.get("IDLANCAMENTO") == item_id and
+                    all(actual.get(k) == v for k, v in replacement.items()),
+                    line["_etag"], record,
+                )
+                if len(applied) == count:
+                    record(None)  # Confirmed by readback after a lost response.
+            conditional_write(
+                lambda: self._write(item_id, values, current),
+                lambda: read_back(LAUNCHES, item_id, values),
+                lambda actual: all(actual.get(k) == v for k, v in values.items()),
+                current["_etag"],
+            )
+        except (requests.RequestException, LaunchGalleryError) as exc:
+            if isinstance(exc, LaunchGalleryError) and exc.code == "payroll_write_pending":
+                raise  # A late write may still commit; do not undo its dependent rows.
+            if applied:
+                try:
+                    actual = read_back(LAUNCHES, item_id, values)
+                except (requests.RequestException, LaunchGalleryError):
+                    uncertain()
+                if actual.get("FORNECEDOR") != current.get("FORNECEDOR"):
+                    uncertain()
+                incomplete = False
+                for line, replacement, tag in reversed(applied):
+                    try:
+                        latest = read_back("FOLHAPGTO", str(line["ID"]), labels)
+                        if (not tag or latest.get("_etag") != tag or latest.get("IDLANCAMENTO") != item_id
+                                or any(latest.get(k) != v for k, v in replacement.items())):
+                            incomplete = True
+                            continue
+                        self._merge_payroll_line(latest, {key: line[key] for key in replacement})
+                    except (requests.RequestException, LaunchGalleryError):
+                        incomplete = True
+                if incomplete:
+                    uncertain()
+            raise
+
