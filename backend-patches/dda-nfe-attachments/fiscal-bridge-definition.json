{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    },
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "manual": {
      "metadata": {},
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "properties": {
            "mode": {
              "enum": [
                "inventory",
                "pdf",
                "dda_sync"
              ],
              "type": "string"
            },
            "afterId": {
              "minimum": 0,
              "type": "integer"
            },
            "itemId": {
              "minimum": 1,
              "type": "integer"
            },
            "filename": {
              "type": "string",
              "maxLength": 100
            },
            "ddaId": {
              "type": "integer",
              "minimum": 1
            },
            "sourceName": {
              "minLength": 32,
              "type": "string",
              "maxLength": 32
            },
            "content": {
              "type": "string",
              "maxLength": 26666668
            },
            "expectedKey": {
              "minLength": 44,
              "type": "string",
              "maxLength": 50
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        "triggerAuthenticationType": "All"
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "outputs"
          ]
        }
      }
    }
  },
  "actions": {
    "Operacao": {
      "actions": {
        "Listar": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "parameters": {
              "dataset": "https://energeticaltda.sharepoint.com/sites/energetica",
              "parameters/method": "GET",
              "parameters/uri": "_api/web/lists/getbytitle('NOTAS_FISCAIS_SEFAZ')/items?$select=Id,Modified,Title,CHAVE_ACESSO,CNPJ_FORNECEDOR,CNPJ_DESTINATARIO,DATA_EMISSAO,VALOR_TOTAL_NOTA,VALOR_LIQUIDO,VALOR_LIQUIDO_FATURA,VALOR_SERVICOS,SITUACAO,STATUS_IMPORTACAO,STATUS_DANFE,TIPO_FISCAL,NUMERO_NOTA&$filter=Id gt @{int(coalesce(triggerBody()?['afterId'],0))}&$orderby=Id asc&$top=200",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata"
              }
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs",
                "outputs"
              ]
            }
          }
        },
        "Responder_lista": {
          "runAfter": {
            "Listar": [
              "Succeeded"
            ]
          },
          "type": "Response",
          "kind": "Http",
          "inputs": {
            "statusCode": 200,
            "body": {
              "page": "@body('Listar')"
            }
          },
          "operationOptions": "Asynchronous",
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          }
        }
      },
      "runAfter": {},
      "else": {
        "actions": {
          "Obter_PDF": {
            "actions": {
              "Ler_nota": {
                "runAfter": {},
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "connectionName": "shared_sharepointonline",
                    "operationId": "HttpRequest"
                  },
                  "parameters": {
                    "dataset": "https://energeticaltda.sharepoint.com/sites/energetica",
                    "parameters/method": "GET",
                    "parameters/uri": "_api/web/lists/getbytitle('NOTAS_FISCAIS_SEFAZ')/items(@{int(triggerBody()?['itemId'])})?$select=Id,Modified,Title,CHAVE_ACESSO,CNPJ_FORNECEDOR,CNPJ_DESTINATARIO,DATA_EMISSAO,VALOR_TOTAL_NOTA,VALOR_LIQUIDO,VALOR_LIQUIDO_FATURA,VALOR_SERVICOS,SITUACAO,STATUS_IMPORTACAO,STATUS_DANFE,TIPO_FISCAL,NUMERO_NOTA",
                    "parameters/headers": {
                      "Accept": "application/json;odata=nometadata"
                    }
                  },
                  "authentication": "@parameters('$authentication')"
                },
                "runtimeConfiguration": {
                  "secureData": {
                    "properties": [
                      "inputs",
                      "outputs"
                    ]
                  }
                }
              },
              "Anexos": {
                "runAfter": {
                  "Ler_nota": [
                    "Succeeded"
                  ]
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                    "connectionName": "shared_sharepointonline",
                    "operationId": "GetItemAttachments"
                  },
                  "parameters": {
                    "dataset": "https://energeticaltda.sharepoint.com/sites/energetica",
                    "table": "NOTAS_FISCAIS_SEFAZ",
                    "itemId": "@int(triggerBody()?['itemId'])"
                  },
                  "authentication": "@parameters('$authentication')"
                },
                "runtimeConfiguration": {
                  "secureData": {
                    "properties": [
                      "inputs",
                      "outputs"
                    ]
                  }
                }
              },
              "PDFs": {
                "runAfter": {
                  "Anexos": [
                    "Succeeded"
                  ]
                },
                "type": "Query",
                "inputs": {
                  "where": "@and(endsWith(toLower(item()?['DisplayName']),'.pdf'),not(startsWith(toLower(item()?['DisplayName']),'cce-')),not(startsWith(toLower(item()?['DisplayName']),'dda-')))",
                  "from": "@body('Anexos')"
