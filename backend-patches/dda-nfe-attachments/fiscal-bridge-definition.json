                "runAfter": {
                  "PDFs": [
                    "Succeeded"
                  ]
                },
                "else": {
                  "actions": {
                    "Indisponivel": {
                      "runAfter": {},
                      "type": "Response",
                      "kind": "Http",
                      "inputs": {
                        "statusCode": 200,
                        "body": {
                          "status": "pdf_unavailable"
                        }
                      },
                      "operationOptions": "Asynchronous",
                      "runtimeConfiguration": {
                        "secureData": {
                          "properties": [
                            "inputs"
                          ]
                        }
                      }
                    }
                  }
                },
                "expression": "@and(equals(length(body('PDFs')),1),equals(body('Ler_nota')?['STATUS_DANFE'],'DISPONIVEL'),equals(body('Ler_nota')?['SITUACAO'],'AUTORIZADA'),equals(body('Ler_nota')?['STATUS_IMPORTACAO'],'XML_COMPLETO'))",
                "type": "If"
              }
            },
