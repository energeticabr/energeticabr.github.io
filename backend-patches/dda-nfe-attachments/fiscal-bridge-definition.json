                "runtimeConfiguration": {
                  "secureData": {
                    "properties": [
                      "inputs",
                      "outputs"
                    ]
                  }
                }
              },
              "PDF_unico": {
                "actions": {
                  "Baixar": {
                    "runAfter": {},
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                        "connectionName": "shared_sharepointonline",
                        "operationId": "GetAttachmentContent"
                      },
                      "parameters": {
                        "dataset": "https://energeticaltda.sharepoint.com/sites/energetica",
                        "table": "NOTAS_FISCAIS_SEFAZ",
                        "itemId": "@int(triggerBody()?['itemId'])",
                        "attachmentId": "@first(body('PDFs'))?['Id']"
                      },
                      "authentication": "@parameters('$authentication')"
                    },
                    "runtimeConfiguration": {
                      "secureData": {
                        "properties": [
                          "inputs",
                          "outputs"
                        ]
                      }
                    }
                  },
                  "Responder_PDF": {
                    "runAfter": {
                      "Baixar": [
                        "Succeeded"
                      ]
                    },
                    "type": "Response",
                    "kind": "Http",
                    "inputs": {
                      "statusCode": 200,
                      "body": {
                        "content": "@body('Baixar')",
                        "filename": "@first(body('PDFs'))?['DisplayName']",
                        "status": "ready",
                        "record": "@body('Ler_nota')"
                      }
                    },
                    "operationOptions": "Asynchronous",
                    "runtimeConfiguration": {
                      "secureData": {
                        "properties": [
                          "inputs"
                        ]
                      }
                    }
                  }
