+"""Complete, read-only parent/child provision queries over a REST adapter.
+
+The adapter supplies ``_internal_field``, ``_list_endpoint``, ``_request`` and
+``_values``. Every invocation reads fresh items; no financial writes or item
+snapshots are cached here. Incomplete reads must raise instead of looking like
+an empty pending list or a known zero amount.
+"""
+
+from __future__ import annotations
+
+import re
+from datetime import date, datetime
+from urllib.parse import parse_qsl, unquote, urljoin, urlsplit
+
+from requests import HTTPError
+
+try:
+    from .logic import normalize_text
+    from .payment_provision_group import (
+        _canonical, _currency, _sum, provision_line_total,
+    )
+except ImportError:  # Legacy OCI packaging imports worker modules directly.
+    from logic import normalize_text
+    from payment_provision_group import (
+        _canonical, _currency, _sum, provision_line_total,
+    )
+
+
+PARENT_LIST = "DESCRITIVOPROVISAO"
+CHILD_LIST = "PROVISÃO PGTOS"
+PARENT_FIELDS = (
+    "Id", "FORNECEDOR", "FILIAL", "OBS", "FORMAPGTO",
+    "DATA PREVISTO PGTO", "DATA PGTO EFETUADO", "PGTOAGENDADO", "VALORTOTAL",
+)
+PARENT_ALIASES = {
+    "DATA PREVISTO PGTO": "DATAPREVISTOPGTO",
+    "DATA PGTO EFETUADO": "DATAPGTOEFETUADO",
+}
+CHILD_FIELDS = (
+    "Id", "DESCRITIVOPROVISAO", "FORNECEDOR", "FILIAL", "IMOVEL",
+    "PRODUTO", "QTD", "VALOR TOTAL", "FRETE", "OBS", "IDLANCAMENTOS",
+    "IDPEDIDO", "DATA PREVISTO PGTO", "DATA PGTO EFETUADO", "FORMAPGTO",
+    "STATUS", "PGTOAGENDADO",
+)
+OPTIONAL_CHILD_FIELDS = ("ETAPA", "TIPO DESPESA")
+MAX_PAGES = 1000
+MAX_ITEMS = 100000
+MAX_SCHEMA_FIELDS = 10000
+PAGE_SIZE = 5000
+
+
+def _item_id(raw):
+    if isinstance(raw, bool) or not isinstance(raw, (int, str)):
+        raise ValueError("A positive, unambiguous provision item ID is required")
+    text = str(raw).strip()
+    if not re.fullmatch(r"[1-9][0-9]*", text):
+        raise ValueError("A positive, unambiguous provision item ID is required")
+    return int(text)
+
+
+def _blank(value):
+    return value is None or (isinstance(value, str) and not value.strip())
+
+
+def _pending(child):
+    return (
+        normalize_text(str(child["STATUS"] or "")) == "pagamento previsto"
+        and _blank(child["DATA PGTO EFETUADO"])
+        and normalize_text(str(child["PGTOAGENDADO"] or "")) != "pago"
+    )
+
+
+def _due_key(parent):
+    raw = parent["DATA PREVISTO PGTO"]
+    if _blank(raw):
+        return (1, date.max, parent["Id"])
+    if isinstance(raw, datetime):
+        due = raw.date()
+    elif isinstance(raw, date):
+        due = raw
+    else:
+        text = str(raw).strip()
+        try:
+            due = date.fromisoformat(text[:10])
+        except ValueError:
+            try:
+                due = datetime.strptime(text, "%d/%m/%Y").date()
+            except ValueError as exc:
+                raise ValueError("Invalid provision description due date") from exc
+    return (0, due, parent["Id"])
+
+
+class ProvisionDescriptionQuery:
+    """Reusable query with bounded, validated SharePoint REST pagination."""
+
+    def __init__(self, client, *, max_pages=MAX_PAGES, max_items=MAX_ITEMS):
+        for name, value, ceiling in (
+            ("max_pages", max_pages, MAX_PAGES),
+            ("max_items", max_items, MAX_ITEMS),
+        ):
+            if isinstance(value, bool) or not isinstance(value, int) or not 1 <= value <= ceiling:
+                raise ValueError(f"Invalid provision query limit: {name}")
+        self.client = client
+        self.max_pages = max_pages
+        self.max_items = max_items
+
+    def _page_key(self, endpoint):
+        site_url = getattr(self.client, "site_url", "")
+        absolute = urljoin(site_url.rstrip("/") + "/_api/", endpoint)
+        parsed = urlsplit(absolute)
+        return (
+            parsed.scheme.lower(), parsed.netloc.lower(), unquote(parsed.path).casefold(),
+            tuple(sorted(parse_qsl(parsed.query, keep_blank_values=True))),
+        )
+
+    def _pages(self, endpoint, params, *, max_items=None):
+        limit = self.max_items if max_items is None else max_items
+        result, seen = [], set()
+        site_url = getattr(self.client, "site_url", "")
+        api = urlsplit(site_url.rstrip("/") + "/_api/") if site_url else None
+        while endpoint:
+            key = self._page_key(endpoint)
+            if key in seen:
+                raise RuntimeError("SharePoint provision pagination cycle")
+            # SharePoint can encode list titles or address the same list by
+            # GUID in a next link. Require the same site/API, not identical
+            # spelling of the collection path, before handing it to transport.
+            if api is not None and (
+                key[:2] != (api.scheme.lower(), api.netloc.lower())
+                or not key[2].startswith(unquote(api.path).casefold())
+            ):
+                raise ValueError("SharePoint provision pagination changed site")
+            if len(seen) >= self.max_pages:
+                raise RuntimeError("SharePoint provision page limit exceeded")
+            seen.add(key)
+            payload = self.client._request("GET", endpoint, params=params)
+            params = None
+            if not isinstance(payload, dict) or "error" in payload:
+                raise ValueError("Invalid SharePoint provision collection payload")
+            data = payload.get("d")
+            if isinstance(data, dict) and "error" in data:
+                raise ValueError("Invalid SharePoint provision collection payload")
+            values = payload.get("value") if "value" in payload else (
+                data.get("results") if isinstance(data, dict) else None
+            )
+            if not isinstance(values, list) or any(not isinstance(row, dict) for row in values):
+                raise ValueError("Invalid SharePoint provision collection values")
+            result.extend(self.client._values(payload))
+            if len(result) > limit:
+                raise RuntimeError("SharePoint provision item limit exceeded")
+            links = [payload.get("odata.nextLink"), payload.get("@odata.nextLink")]
+            if isinstance(data, dict):
+                links.append(data.get("__next"))
+            links = [link for link in links if link is not None and link != ""]
+            if any(not isinstance(link, str) or not link.strip() for link in links):
+                raise ValueError("Invalid SharePoint provision next link")
+            if len(set(links)) > 1:
+                raise ValueError("Conflicting SharePoint provision next links")
+            endpoint = links[0] if links else None
+        return result
+
+    def _projection(self, list_title, fields, *, aliases=None, optional=()):
+        """Validate every selected internal name against the complete schema."""
+        schema = self._pages(
+            self.client._list_endpoint(list_title) + "/fields",
+            {"$select": "Title,InternalName,StaticName,TypeAsString,ReadOnlyField",
+             "$top": str(PAGE_SIZE)},
+            max_items=MAX_SCHEMA_FIELDS,
+        )
+        names, by_label = set(), {}
+        for row in schema:
+            internal = row.get("InternalName") or row.get("StaticName")
+            if not isinstance(internal, str) or not internal.strip():
+                raise ValueError("Invalid SharePoint provision field schema")
+            names.add(internal)
+            for label in (internal, row.get("Title"), row.get("StaticName")):
+                if label:
+                    by_label[normalize_text(str(label))] = internal
+        projection = {}
+        for field in (*fields, *optional):
+            alias = (aliases or {}).get(field, field)
+            internal = self.client._internal_field(list_title, alias)
+            if internal not in names:
+                internal = by_label.get(normalize_text(alias)) or by_label.get(normalize_text(field))
+            if internal not in names:
+                if field in optional:
+                    continue
+                raise ValueError(f"Required SharePoint provision field is missing: {field}")
+            projection[field] = internal
+        return projection
+
+    @staticmethod
+    def _row(row, projection):
+        if not isinstance(row, dict) or any(internal not in row for internal in projection.values()):
+            raise ValueError("SharePoint provision item omitted selected fields")
+        mapped = {field: row[internal] for field, internal in projection.items()}
+        mapped["Id"] = _item_id(mapped["Id"])
+        return mapped
+
+    def _items(self, list_title, projection):
+        raw = self._pages(
+            self.client._list_endpoint(list_title) + "/items",
+            {"$select": ",".join(dict.fromkeys(projection.values())),
+             "$orderby": "Id asc", "$top": str(PAGE_SIZE)},
+        )
+        result, seen = [], set()
+        for row in raw:
+            mapped = self._row(row, projection)
+            if mapped["Id"] in seen:
+                raise ValueError("Duplicate SharePoint provision item ID")
+            seen.add(mapped["Id"])
+            result.append(mapped)
+        return result
+
+    def _children(self):
+        projection = self._projection(CHILD_LIST, CHILD_FIELDS, optional=OPTIONAL_CHILD_FIELDS)
+        return self._items(CHILD_LIST, projection)
+
+    @staticmethod
+    def _linked(children):
+        groups = {}
+        for child in children:
+            link = child["DESCRITIVOPROVISAO"]
+            if isinstance(link, str) and re.fullmatch(r"[1-9][0-9]*", link.strip()):
+                groups.setdefault(link.strip(), []).append(child)
+        return groups
+
+    @staticmethod
+    def _group(parent, children, allow_invalid_totals=False):
+        if not children:
+            raise ValueError("Provision description has no linked children; total is unknown")
+        children = sorted(children, key=lambda child: child["Id"])
+        totals, invalid_fields = [], set()
+        amount_errors = {
+            f"Invalid provision number: {field}": field
+            for field in ("QTD", "VALOR TOTAL", "FRETE")
+        }
+        for child in children:
+            fields = dict(child)
+            if _blank(fields["FRETE"]):
+                fields["FRETE"] = "0"
+            try:
+                totals.append(provision_line_total(fields))
+            except ValueError as exc:
+                # Only the pure line validator's known amount errors can
+                # disable a group. Never turn other failures into a partial
+                # result, and never expose private values in popup messages.
+                field = amount_errors.get(str(exc))
+                if not allow_invalid_totals or field is None:
+                    raise
+                invalid_fields.add(field)
+        group = {
+            **parent,
+            "CHILDREN": children,
+            "PENDING CHILD IDS": [str(child["Id"]) for child in children if _pending(child)],
+            "sourceKind": "provision-description",
+        }
+        if invalid_fields:
+            return {
+                **group,
+                "VALOR TOTAL DESCRITIVO": None,
+                "totalDisplay": "—",
+                "settlementBlocked": True,
+                "amountError": (
+                    "Total indisponível: valor ausente ou inválido em "
+                    + ", ".join(sorted(invalid_fields))
+                    + ". Corrija os filhos antes de efetuar o pagamento."
+                ),
+            }
+        total = _sum(totals)
+        return {**group, "VALOR TOTAL DESCRITIVO": _canonical(total),
+                "totalDisplay": _currency(total)}
+
+    def get_pending_provision_descriptions(self) -> list[dict]:
+        """Return due/ID-ordered parents with at least one pending child.
+
+        All linked children contribute to the total, including paid children.
+        Parent payment markers never hide an unfinished child settlement.
+        Known amount validation failures retain the whole group with a blocked,
+        unknown total; schema, transport and pagination failures still raise.
+        """
+        projection = self._projection(PARENT_LIST, PARENT_FIELDS, aliases=PARENT_ALIASES)
+        parents = self._items(PARENT_LIST, projection)
+        linked = self._linked(self._children())
+        result = []
+        for parent in parents:
+            children = linked.get(str(parent["Id"]), [])
+            if any(_pending(child) for child in children):
+                result.append(self._group(parent, children, allow_invalid_totals=True))
+        return sorted(result, key=_due_key)
+
+    def get_provision_description(self, parent_id) -> dict:
+        """Fresh complete group for retry, even if every child is now paid.
+
+        Invalid IDs raise ValueError; absent parents raise LookupError. REST,
+        schema, pagination and amount errors propagate without partial results.
+        """
+        parent_id = _item_id(parent_id)
+        projection = self._projection(PARENT_LIST, PARENT_FIELDS, aliases=PARENT_ALIASES)
+        try:
+            payload = self.client._request(
+                "GET", self.client._list_endpoint(PARENT_LIST) + f"/items({parent_id})",
+                params={"$select": ",".join(dict.fromkeys(projection.values()))},
+            )
+        except HTTPError as exc:
+            if exc.response is not None and exc.response.status_code == 404:
+                raise LookupError("Provision description parent was not found") from exc
+            raise
+        if isinstance(payload, dict) and isinstance(payload.get("d"), dict):
+            payload = payload["d"]
+        parent = self._row(payload, projection)
+        if parent["Id"] != parent_id:
+            raise ValueError("SharePoint returned a different provision parent ID")
+        linked = self._linked(self._children())
+        return self._group(parent, linked.get(str(parent_id), []))
