+"""Read contracts and durable preparation/settlement of a provision description.
+
+No remote writes before confirmation. Financial children retain their individual
+amounts and optional launch decisions; shared payment facts belong to the parent.
+"""
+from __future__ import annotations
+
+import copy
+import hashlib
+from datetime import date, datetime, timedelta
+from zoneinfo import ZoneInfo
+from requests import HTTPError
+
+try:
+    from .payment_provision_group import provision_line_total, _currency, _canonical, _sum
+    from .document_item_lock import document_item_lock
+    from .logic import resolve_option, filter_options
+except ImportError:
+    from payment_provision_group import provision_line_total, _currency, _canonical, _sum
+    from document_item_lock import document_item_lock
+    from logic import resolve_option, filter_options
+
+SOURCE_KIND = 'provision-description'
+PARENT_LIST = 'DESCRITIVOPROVISAO'
+CHILD_LIST = 'PROVISÃO PGTOS'
+COMMON_FIELDS = ('DATA PGTO EFETUADO', 'FORMAPGTO', 'OBS')
+PARENT_FIELDS = ('DATA PREVISTO PGTO', 'FORNECEDOR', 'FILIAL', 'DATA PGTO EFETUADO',
+                 'FORMAPGTO', 'OBS', 'PGTOAGENDADO', 'VALORTOTAL')
+CHILD_FIELDS = ('DESCRITIVOPROVISAO', 'STATUS', 'DATA PGTO EFETUADO', 'PGTOAGENDADO',
+                'QTD', 'VALOR TOTAL', 'FRETE', 'FORMAPGTO', 'OBS', 'IDLANCAMENTOS',
+                'IDPEDIDO', 'DATA PREVISTO PGTO', 'FILIAL', 'FORNECEDOR', 'IMOVEL', 'PRODUTO')
+
+
+def _text(value):
+    return '' if value is None else str(value).strip()
+
+
+def _identity(value):
+    text = _text(value)
+    if not text.isdigit() or int(text) <= 0:
+        raise ValueError('ID do descritivo/provisão inválido')
+    return str(int(text))
+
+
+def _date(value):
+    text = _text(value)
+    for fmt in ('%Y-%m-%d', '%d/%m/%Y'):
+        try:
+            return datetime.strptime(text[:10], fmt).date()
+        except ValueError:
+            pass
+    return None
+
+
+def _pending(row):
+    return (_text(row.get('STATUS')).casefold() == 'pagamento previsto'
+            and not _text(row.get('DATA PGTO EFETUADO'))
+            and _text(row.get('PGTOAGENDADO')).casefold() != 'pago')
+
+
+def _same(key, left, right):
+    if key in {'DATA PGTO EFETUADO', 'DATA PREVISTO PGTO'} and _text(left) and _text(right):
+        return _date(left) is not None and _date(left) == _date(right)
+    if key in {'QTD', 'VALOR TOTAL', 'FRETE', 'VALORTOTAL'} and _text(left) and _text(right):
+        try:
+            from decimal import Decimal
+            return Decimal(str(left).replace(',', '.')) == Decimal(str(right).replace(',', '.'))
+        except Exception:
+            return False
+    return _text(left) == _text(right)
+
+
+def _verified(value):
+    return value is True or (isinstance(value, dict) and value.get('fields') is True
+                             and value.get('attachments') is True)
+
+
+def _joined(children, field):
+    return ' / '.join(dict.fromkeys(_text(item.get(field)) for item in children if _text(item.get(field))))
+
+
+def _common(fields):
+    common = {key: copy.deepcopy(fields.get(key)) for key in COMMON_FIELDS}
+    # Text/Note payloads in the legacy client stringify non-string values.
+    # Use one representation in writes, checkpoints and retry comparisons.
+    common['OBS'] = _text(common.get('OBS'))
+    return common
+
+
+def group_options(groups):
+    options = []
+    for group in groups:
+        if group.get('settlementBlocked'):
+            continue
+        item_id = _identity(group['Id'])
+        children = group.get('CHILDREN') or []
+        options.append({
+            'id': f'provision_description:{item_id}', 'value': item_id,
+            'title': f"DESCRITIVO {item_id} — {_text(group.get('FORNECEDOR'))} "
+                     f"({_text(group.get('DATA PREVISTO PGTO'))[:10]}) — "
+                     f"{len(children)} provisão(ões) — {group['totalDisplay']}",
+            'source_values': copy.deepcopy(group), 'sourceKind': SOURCE_KIND,
+        })
+    return options
+
+
+def group_snapshot(groups, today):
+    rows = []
+    for group in groups:
+        due = _date(group.get('DATA PREVISTO PGTO'))
+        if due is None or due > today + timedelta(days=2):
+            continue
+        children = group.get('CHILDREN') or []
+        rows.append({
+            'id': _identity(group['Id']), 'sourceKind': SOURCE_KIND,
+            'dueDate': due.isoformat(), 'supplier': _text(group.get('FORNECEDOR')),
+            'branch': _text(group.get('FILIAL')), 'property': _joined(children, 'IMOVEL'),
+            'product': _joined(children, 'PRODUTO'), 'childCount': len(children),
+            'pendingChildIds': list(group.get('PENDING CHILD IDS') or []),
+            'total': None if group.get('settlementBlocked') else str(group['VALOR TOTAL DESCRITIVO']),
+            'totalDisplay': group['totalDisplay'],
+            'settlementBlocked': bool(group.get('settlementBlocked')),
+            'amountError': _text(group.get('amountError')),
+        })
+    rows.sort(key=lambda row: (row['dueDate'], int(row['id'])))
+    return {'sourceKind': SOURCE_KIND, 'today': today.isoformat(),
+            'checkedDate': today.isoformat(), 'due': bool(rows), 'count': len(rows), 'rows': rows}
