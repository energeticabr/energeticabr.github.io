+class ProvisionDescriptionSettlement:
+    def _provision_attachments_locked(self, state):
+        journal = ((state or {}).get('provision_description') or {}).get('journal') or {}
+        return bool(journal.get('intent')) or super()._provision_attachments_locked(state)
+
+    def _provision_validate_frozen_attachments(self, state):
+        group = state.get('provision_description') or {}
+        journal = group.get('journal') or {}
+        if not journal.get('intent'):
+            return super()._provision_validate_frozen_attachments(state)
+        frozen = journal.get('attachments')
+        digests = journal.get('attachment_digests')
+        if frozen != state.get('attachments', []) or digests is None or len(digests) != len(frozen or []):
+            raise RuntimeError('Os anexos da baixa iniciada não podem ser alterados.')
+        for attachment, digest in zip(frozen, digests):
+            if hashlib.sha256(self.media_repository.read(attachment)).hexdigest() != digest:
+                raise RuntimeError('Um arquivo da baixa iniciada foi alterado.')
+
+    def _handle_frozen_provision(self, event, state, etag):
+        group = (state or {}).get('provision_description') or {}
+        command = _text(event.get('reply_id') or event.get('text')).casefold()
+        if (group.get('review_required') and not (group.get('journal') or {}).get('intent')
+                and command == 'description_review_again'):
+            self._mark_processed(state, event.get('message_id'))
+            try:
+                self._description_start(state, self.sharepoint.get_provision_description(group['parent_id']))
+                state['stage'] = 'selecting_fields'
+                etag = self._save(state, etag)
+                return self._prompt_next_or_summary(state, etag)
+            except Exception as error:
+                return self._submission_failed(state, etag, error)
+        if not (group.get('journal') or {}).get('intent') or state.get('stage') == 'completed':
+            return super()._handle_frozen_provision(event, state, etag)
+        if event.get('message_id') in state.get('processed_message_ids', []):
+            return {'status': 'duplicate', 'batch_id': state['batch_id']}
+        if command in {'resumo', 'res', 'flow_summary'}:
+            return self._send_progress_summary(state)
+        if state.get('stage') == 'notifying':
+            return self._notify_completed(state, etag)
+        self._mark_processed(state, event.get('message_id'))
+        if event.get('kind') == 'text' and command in {'error_retry', 'retry_submission',
+                                                       'tentar novamente', 'confirm_yes', 'sim'}:
+            if self._sharepoint_storage_retry_is_blocked(state):
+                return self._storage_retry_blocked_result(state, etag)
+            state['stage'] = 'committing'
+            etag = self._save(state, etag)
+            return self._commit(state, etag)
+        self._send_text(state, 'A BAIXA DESTE DESCRITIVO JÁ COMEÇOU. CONCLUA A TENTATIVA '
+                        'PRESERVADA ANTES DE VOLTAR OU ALTERAR DADOS.')
+        self.messenger.send_actions(state, 'CONCLUIR BAIXA PENDENTE',
+            [{'id': 'error_retry', 'title': '🔄 TENTAR NOVAMENTE', 'reply': 'error_retry'}])
+        etag = self._save(state, etag)
+        return {'status': 'provision_submission_locked', 'batch_id': state['batch_id'], 'etag': etag}
+
+    def _description_flow_config(self, state, base):
+        group = state.get('provision_description')
+        if not group or state.get('_description_child_commit'):
+            return base
+        flow = copy.deepcopy(base)
+        obs = group.get('parent', {}).get('OBS')
+        options = [{'id': 'description_observation_blank', 'title': 'SEM OBSERVAÇÃO', 'value': ''}]
+        if _text(obs):
+            options.insert(0, {'id': 'description_observation_keep',
+                              'title': 'MANTER OBSERVAÇÃO: ' + str(obs), 'value': obs})
+        flow['steps'].insert(5, {
+            'key': 'observacao_grupo_baixa', 'kind': 'selection', 'target_field': 'OBS',
+            'free_text_target_field': 'OBS', 'button_label': 'OBSERVAÇÃO',
+            'prompt': 'QUAL É A OBSERVAÇÃO PARA TODOS OS ITENS DESTE DESCRITIVO? '
+                      'Digite um texto ou escolha SEM OBSERVAÇÃO.',
+            'source': {'type': 'static', 'options': options},
+        })
+        for step in flow['steps']:
+            if step.get('target_field') == 'OBS' and step['key'] != 'observacao_grupo_baixa':
+                step['editable'] = False
+        if group.get('common') and state.get('edit_step_indices') is None:
+            for step in flow['steps']:
+                if step['key'] in {'data_pgto_efetuado_baixa', 'forma_pgto_baixa', 'observacao_grupo_baixa'}:
+                    step['when'] = {'field': '__description_common_not_asked_again__', 'equals': 'SIM'}
+        flow['blank_review_fields'] = [item for item in flow.get('blank_review_fields', []) if item['field'] != 'OBS']
+        flow['confirmation_prompt'] = ('CONFIRMA A BAIXA DE TODOS OS ITENS PENDENTES '
+                                       f"DO DESCRITIVO {group['parent_id']}?")
+        return flow
+
+    def _description_start(self, state, source):
+        if source.get('settlementBlocked'):
+            raise ValueError(source.get('amountError') or 'Valor inválido em uma provisão vinculada.')
+        parent_id = _identity(source['Id'])
+        all_children = copy.deepcopy(source.get('CHILDREN') or [])
+        children = sorted((item for item in all_children if _pending(item)), key=lambda item: int(item['Id']))
+        if not children:
+            raise RuntimeError('Este descritivo não possui mais provisões pendentes. Atualize a lista.')
+        state['provision_description'] = {
+            'parent_id': parent_id, 'parent': copy.deepcopy(source),
+            'original_children': all_children, 'children': children,
+            'index': 0, 'entries': [], 'common': None, 'prepared': False,
+        }
+        self._description_load_child(state, 0)
+
+    def _description_load_child(self, state, index):
+        group = state['provision_description']
+        child = group['children'][index]
+        if _identity(child.get('DESCRITIVOPROVISAO')) != group['parent_id']:
+            raise RuntimeError('Uma provisão não pertence ao descritivo selecionado.')
+        group['index'] = index
+        state['fields'] = {key: copy.deepcopy(value) for key, value in child.items() if key in CHILD_FIELDS}
+        state['fields']['ID PROVISÃO'] = _identity(child['Id'])
+        if not index:
+            state['fields']['OBS'] = group['parent'].get('OBS')
+        else:
+            state['fields'].update(copy.deepcopy(group['common']))
+        for field in ('DATA PREVISTO PGTO', 'DATA PGTO EFETUADO'):
+            if state['fields'].get(field):
+                state['fields'][field] = _text(state['fields'][field])[:10]
+        state['display_values'] = {key: _text(value) or 'EM BRANCO' for key, value in state['fields'].items()}
+        state['answers'] = {}
+        state['selections'] = {}
+        state['step_index'] = 1
+        state['options'] = []
+        state['confirm_or_replace_number_modes'] = {}
+        for key in ('payment_settlement_blank_review_done', 'payment_settlement_blank_fill_active',
+                    'payment_settlement_blank_fields', 'payment_settlement_relink_authorized',
+                    'payment_settlement_password_attempts', 'edit_step_indices', 'option_pagination'):
+            state.pop(key, None)
+        self._send_text(state, f"DESCRITIVO {group['parent_id']} — PROVISÃO {_identity(child['Id'])} "
+                        f"({index + 1} DE {len(group['children'])}).")
+
+    def _description_after_fields(self, state, etag):
+        group = state.get('provision_description')
+        if not group or state.get('flow') != 'payment_settlement':
+            return None
+        common = _common(state['fields'])
+        was_prepared = bool(group.get('prepared'))
+        if not group.get('common') or group.get('editing_common'):
+            group['common'] = common
+        entry = {key: copy.deepcopy(state.get(key) or {}) for key in ('fields', 'answers', 'display_values')}
+        entry['relink_authorized'] = bool(state.get('payment_settlement_relink_authorized'))
+        index = group['index']
+        if index < len(group['entries']):
+            group['entries'][index] = entry
+        else:
+            group['entries'].append(entry)
+        if was_prepared:
+            return None
+        if index + 1 < len(group['children']):
+            self._description_load_child(state, index + 1)
+            etag = self._save(state, etag)
+            return self._prompt_next_or_summary(state, etag)
+        group['prepared'] = True
+        return None
+
+    def _description_edit_step(self):
+        return {'key': 'edit_field', 'prompt': 'QUAL PROVISÃO OU DADO COMUM VOCÊ DESEJA EDITAR?',
+                'button_label': 'ESCOLHER PROVISÃO', 'allow_blank': False}
+
+    def _prompt_description_edit_choice(self, state, etag):
+        group = state['provision_description']
+        group['editing_phase'] = 'choose'
+        group.pop('editing_index', None)
+        options = [{'id': 'description_edit_back', 'title': '↩️ VOLTAR AO RESUMO', 'value': '__back_to_summary__'},
+                   {'id': 'description_edit_common', 'title': 'DADOS COMUNS — DATA, FORMA PGTO E OBS', 'value': '__common__'},
+                   {'id': 'description_edit_attachments', 'title': '📎 ANEXOS DO DESCRITIVO', 'value': '__edit_attachments__'}]
+        for index, entry in enumerate(group['entries']):
+            fields = entry['fields']
+            options.append({'id': 'description_edit_child:' + str(fields['ID PROVISÃO']), 'value': index,
+                'title': f"PROVISÃO {fields['ID PROVISÃO']} — {_text(fields.get('FORNECEDOR'))} — {_text(fields.get('PRODUTO'))}"})
+        state['stage'], state['options'] = 'editing_field_choice', options
+        self._send_options(state, self._description_edit_step(), options)
+        etag = self._save(state, etag)
+        return {'status': 'awaiting_description_edit_choice', 'batch_id': state['batch_id'], 'etag': etag}
+
+    def _handle_description_edit_choice(self, event, state, etag):
+        raw = event.get('reply_id') or event.get('text') or ''
+        self._mark_processed(state, event.get('message_id'))
+        selected = resolve_option(raw, state['options'], 'edit_field')
+        if selected is None:
+            matches = list(filter_options(raw, state['options']))
+            self._send_filtered_options(state, self._description_edit_step(), matches or state['options'])
+            etag = self._save(state, etag)
+            return {'status': 'filtered_description_edit_choice', 'batch_id': state['batch_id'], 'etag': etag}
+        value = selected['value']
+        if value == '__back_to_summary__':
+            return self._summarize_and_confirm(state, etag)
+        if value == '__edit_attachments__':
+            return self._prompt_attachment_edit_menu(state, etag)
+        group = state['provision_description']
+        index = 0 if value == '__common__' else int(value)
+        entry = group['entries'][index]
+        for key in ('fields', 'answers', 'display_values'):
+            state[key] = copy.deepcopy(entry[key])
+        state['fields'].update(group['common'])
+        state['display_values'].update({key: _text(value) or 'EM BRANCO' for key, value in group['common'].items()})
+        state['payment_settlement_relink_authorized'] = entry['relink_authorized']
+        group['index'] = group['editing_index'] = index
+        group['editing_phase'], group['editing_common'] = 'field', value == '__common__'
+        state.pop('edit_step_indices', None)
+        return self._prompt_edit_field(state, etag)
+
+    def _description_edit_field_options(self, state, options):
+        group = state.get('provision_description') or {}
+        if group.get('editing_phase') != 'field':
+            return options
+        steps = self._flow_config(state)['steps']
+        result = []
+        for option in options:
+            index = option.get('value')
+            if index == '__back_to_summary__':
+                result.append(option)
+            elif isinstance(index, int) and 0 < index < len(steps):
+                shared = steps[index].get('target_field') in COMMON_FIELDS
+                if shared == bool(group.get('editing_common')):
+                    result.append(option)
+        return result
+
+    def _description_summary_rows(self, state):
+        group = state['provision_description']
+        common = group.get('common') or {}
+        rows = [{'label': 'DESCRITIVO DE PROVISÃO', 'value': 'ID ' + group['parent_id']},
+                {'label': 'FORNECEDOR DE REFERÊNCIA', 'value': _text(group['parent'].get('FORNECEDOR'))}]
+        rows.extend({'label': key, 'value': _text(common.get(key)) or 'EM BRANCO'} for key in COMMON_FIELDS)
+        entries = {str(item['fields']['ID PROVISÃO']): item for item in group['entries']}
+        totals = []
+        for item in sorted(group['original_children'], key=lambda item: int(item['Id'])):
+            entry = entries.get(str(item['Id']))
+            fields = entry['fields'] if entry else item
+            total = provision_line_total({**fields, 'FRETE': fields.get('FRETE') or '0'})
+            totals.append(total)
+            detail = (f"{_text(fields.get('FORNECEDOR'))} | {_text(fields.get('PRODUTO'))} | "
+                      f"QTD {_text(fields.get('QTD'))} | UNIT {_text(fields.get('VALOR TOTAL'))} | "
+                      f"FRETE {_text(fields.get('FRETE')) or '0'} | TOTAL {_currency(total)}")
+            if not entry:
+                detail += ' | JÁ BAIXADA (NÃO SERÁ ALTERADA)'
+            else:
+                detail += ' | SUBMETER LANÇAMENTO: ' + _text(entry['answers'].get('submeter_lancamentos'))
+                for key in ('ETAPA', 'TIPO DESPESA', 'FILIAL', 'IMOVEL'):
+                    detail += f" | {key}: {_text(fields.get(key)) or 'EM BRANCO'}"
+            rows.append({'label': 'PROVISÃO ID ' + str(item['Id']), 'value': detail})
+        rows.append({'label': 'VALOR TOTAL', 'value': _currency(_sum(totals))})
+        return rows
+
+    def _description_preflight(self, state):
+        group = state['provision_description']
+        fresh = self.sharepoint.get_provision_description(group['parent_id'])
+        expected = {str(item['Id']): item for item in group['original_children']}
+        actual = {str(item['Id']): item for item in fresh.get('CHILDREN') or []}
+        if set(expected) != set(actual):
+            raise RuntimeError('Os itens vinculados ao descritivo mudaram. Revise os dados antes de baixar.')
+        journal = group.get('journal') or {}
+        for item_id, original in expected.items():
+            current = actual[item_id]
+            if _identity(current.get('DESCRITIVOPROVISAO')) != group['parent_id']:
+                raise RuntimeError('O vínculo de uma provisão foi alterado. A baixa foi interrompida.')
+            if item_id in (journal.get('children') or {}):
+                continue
+            in_flight = journal.get('in_flight') or {}
+            if (in_flight.get('id') == item_id and in_flight.get('record')
+                    and all(_same(key, current.get(key), value)
+                            for key, value in in_flight['expected_fields'].items())):
+                verification = self.sharepoint.verify_item(int(item_id), in_flight['expected_fields'], [], target_list=CHILD_LIST)
+                if not _verified(verification):
+                    raise RuntimeError(f'Não foi possível confirmar a provisão {item_id}.')
+                journal['children'][item_id] = {**in_flight['record'], 'verified': verification,
+                                                'target_list': CHILD_LIST,
+                                                'expected_fields': in_flight['expected_fields']}
+                journal.pop('in_flight', None)
+                continue
+            for key in CHILD_FIELDS:
+                if not _same(key, original.get(key), current.get(key)):
+                    raise RuntimeError(f'A provisão {item_id} foi alterada por outra pessoa ({key}). Revise antes de baixar.')
+        return fresh
+
+    def _description_commit(self, state, etag, flow):
+        group = state['provision_description']
+        try:
+            if not group.get('prepared') or len(group['entries']) != len(group['children']):
+                raise RuntimeError('Todos os itens precisam ser revisados antes da baixa.')
+            # Same-host coordination complements remote conditional writes.
+            # The namespace is distinct from DOCUMENTOS locks, using a stable
+            # large positive key; no document ID in the supported SP range collides.
+            lock_id = 10**18 + int(group['parent_id'])
+            with document_item_lock(lock_id):
+                fresh = self._description_preflight(state)
+                journal = group.setdefault('journal', {'parent': None, 'children': {}})
+                had_intent = bool(journal.get('intent'))
+                if journal.get('intent'):
+                    self._provision_validate_frozen_attachments(state)
+                common = _common(group['common'])
+                group['common'] = common
+                if not common.get('DATA PGTO EFETUADO') or not _text(common.get('FORMAPGTO')):
+                    raise RuntimeError('Data efetiva e forma de pagamento são obrigatórias.')
+                entries = {str(item['fields']['ID PROVISÃO']): item for item in group['entries']}
+                total = _sum(provision_line_total({**(entries.get(str(item['Id']), {}).get('fields') or item),
+                                                   'FRETE': (entries.get(str(item['Id']), {}).get('fields') or item).get('FRETE') or '0'})
+                             for item in group['original_children'])
+                # PGTOAGENDADO in the parent is DateTime, unlike the child's
+                # text marker. Preserve scheduling fields; write actual payment
+                # date, account, observation and the recomputed aggregate only.
+                parent_fields = {**common, 'VALORTOTAL': _canonical(total)}
+                parent_current, parent_etag = self.sharepoint.get_item_fields_with_etag(
+                    int(group['parent_id']), PARENT_FIELDS, target_list=PARENT_LIST)
+                parent_matches_intent = bool(journal.get('intent')) and all(
+                    _same(key, parent_current.get(key), value) for key, value in journal['intent'].items())
+                if journal.get('parent') or parent_matches_intent:
+                    for key, expected_value in parent_fields.items():
+                        if not _same(key, parent_current.get(key), expected_value):
+                            raise RuntimeError('O descritivo mudou depois do início da baixa. Dados preservados.')
+                else:
+                    original = group['parent']
+                    for key in PARENT_FIELDS:
+                        if not _same(key, parent_current.get(key), original.get(key)):
+                            raise RuntimeError(f'O descritivo foi alterado ({key}). Revise antes de baixar.')
+                    if _text(parent_current.get('DATA PGTO EFETUADO')) and any(
+                        not _same(key, parent_current.get(key), value) for key, value in common.items()
+                    ):
+                        raise RuntimeError('O descritivo já registra outro pagamento. Não será sobrescrito.')
+                    group.pop('review_required', None)
+                    journal['intent'] = copy.deepcopy(parent_fields)
+                    journal['attachments'] = copy.deepcopy(state.get('attachments') or [])
+                    journal['attachment_digests'] = [hashlib.sha256(self.media_repository.read(attachment)).hexdigest()
+                                                     for attachment in journal['attachments']]
+                    etag = self._save(state, etag)
+                    try:
+                        self.sharepoint.update_item_with_etag(int(group['parent_id']), parent_fields,
+                                                             parent_etag, target_list=PARENT_LIST)
+                    except HTTPError as rejected:
+                        # This first conditional attempt has no prior parent or
+                        # child effects. Explicit 4xx refusals are definitive;
+                        # lost responses/timeouts/5xx remain protected instead.
+                        status = rejected.response.status_code if rejected.response is not None else None
+                        if not had_intent and status in {400, 401, 403, 404, 409, 412, 422}:
+                            for key in ('intent', 'attachments', 'attachment_digests'):
+                                journal.pop(key, None)
+                            group['review_required'] = True
+                            etag = self._save(state, etag)
+                        raise
+                names = []
+                for attachment in state.get('attachments') or []:
+                    self.sharepoint.ensure_attachment(int(group['parent_id']), attachment['sharepoint_name'],
+                                                     self.media_repository.read(attachment), attachment.get('mime_type'),
+                                                     target_list=PARENT_LIST)
+                    names.append(attachment['sharepoint_name'])
+                parent_verification = self.sharepoint.verify_item(int(group['parent_id']), parent_fields, names,
+                                                                  target_list=PARENT_LIST)
+                if not _verified(parent_verification):
+                    raise RuntimeError('Não foi possível confirmar a gravação do descritivo.')
+                journal['parent'] = {'item_id': int(group['parent_id']), 'target_list': PARENT_LIST,
+                                     'verified': parent_verification, 'attachment_names': names}
+                etag = self._save(state, etag)
+                for item_id in sorted(entries, key=int):
+                    if item_id in journal['children']:
+                        saved = journal['children'][item_id]
+                        verification = self.sharepoint.verify_item(int(item_id), saved['expected_fields'], [], target_list=CHILD_LIST)
+                        if not _verified(verification):
+                            raise RuntimeError(f'Não foi possível confirmar a provisão {item_id} já baixada.')
+                        continue
+                    entry = entries[item_id]
+                    live, child_etag = self.sharepoint.get_item_fields_with_etag(int(item_id), CHILD_FIELDS, target_list=CHILD_LIST)
+                    original = next(item for item in group['children'] if str(item['Id']) == item_id)
+                    if any(not _same(key, live.get(key), original.get(key)) for key in CHILD_FIELDS):
+                        raise RuntimeError(f'A provisão {item_id} mudou durante a baixa. A retomada foi preservada.')
+                    child_state = copy.deepcopy(state)
+                    child_state.pop('provision_description', None)
+                    child_state['fields'] = {**copy.deepcopy(entry['fields']), **common}
+                    child_state['answers'] = copy.deepcopy(entry['answers'])
+                    child_state['display_values'] = copy.deepcopy(entry['display_values'])
+                    child_state['batch_id'] = f"{state['batch_id']}-DESCRITIVO-{group['parent_id']}-PROVISAO-{item_id}"
+                    child_state['attachments'] = []
+                    child_state['payment_settlement_relink_authorized'] = entry['relink_authorized']
+                    child_state['_description_child_commit'] = True
+                    child_state['_description_child_etag'] = child_etag
+                    journal['in_flight'] = {'id': item_id, 'expected_fields': copy.deepcopy(child_state['fields'])}
+                    etag = self._save(state, etag)
+                    def checkpoint(expected_fields, prepared_record):
+                        nonlocal etag
+                        journal['in_flight'] = {'id': item_id, 'expected_fields': copy.deepcopy(expected_fields),
+                                                'record': copy.deepcopy(prepared_record)}
+                        etag = self._save(state, etag)
+                    record = self._commit_payment_settlement(child_state, None, flow, on_prepared=checkpoint)
+                    if not _verified(record.get('verified')):
+                        raise RuntimeError(f'Não foi possível confirmar a provisão {item_id}.')
+                    expected_update = {**common, 'PGTOAGENDADO': 'PAGO', 'QTD': child_state['fields']['QTD'],
+                                       'VALOR TOTAL': child_state['fields']['VALOR TOTAL'],
+                                       'FRETE': child_state['fields'].get('FRETE') or '0'}
+                    for key, ref in (('IDPEDIDO', 'related_item'), ('IDLANCAMENTOS', 'launch_item')):
+                        if record.get(ref):
+                            expected_update[key] = str(record[ref]['item_id'])
+                    journal['children'][item_id] = {**record, 'target_list': CHILD_LIST, 'expected_fields': expected_update}
+                    journal.pop('in_flight', None)
