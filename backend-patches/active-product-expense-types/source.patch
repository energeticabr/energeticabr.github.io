+def guard_product_expense_type(engine, state, etag, flow, token):
+    if state.get('flow') != 'supply_product_registration':
+        return None, None
+    index, step = next(
+        (index, step) for index, step in enumerate(flow['steps'])
+        if step.get('key') == 'tipo_despesa_produto_cadastro'
+    )
+    step_for_lookup = step_with_create(engine, state, step)
+    options = engine.sharepoint.get_options(step_for_lookup, engine._context(state))
+    active_types = {option['value'] for option in options if option.get('value')}
+    if state['fields'].get('TIPODESPESA') in active_types:
+        return None, None
+
+    # A previous attempt may already have written this same product. Read it
+    # by the submission token before asking the user to edit the draft.
+    target = flow['target_list']
+    existing = engine.sharepoint._find_item(token, target, flow.get('idempotency_field', 'Title'))
+    if existing:
+        saved = engine.sharepoint.get_item_fields(existing['Id'], ['TIPODESPESA'], target)
+        expense_type = saved.get('TIPODESPESA')
+        if not expense_type:
+            raise RuntimeError('O produto já gravado não tem tipo de despesa para conciliar.')
+        state['fields']['TIPODESPESA'] = expense_type
+        state['display_values']['TIPODESPESA'] = expense_type
+        # Skip the create path even if the recorded type was blocked since submission.
+        return existing['Id'], None
+
+    engine._clear_step_value(state, step)
+    state['step_index'] = index
+    state['edit_step_indices'] = [index]
+    state['options'] = []
+    state.pop('option_pagination', None)
+    engine._send_text(state, 'O TIPO DE DESPESA SELECIONADO NÃO ESTÁ ATIVO. SELECIONE UM TIPO ATIVO.')
+    return None, engine._prompt_next_or_summary(state, etag)
