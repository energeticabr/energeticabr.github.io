[Unit]
Description=Cadastrar provisões solicitadas e anexar documentos da Swile
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=energetica-whatsapp
Group=energetica-whatsapp
WorkingDirectory=/opt/energetica-whatsapp
ExecStart=/opt/energetica-whatsapp/.venv/bin/python -B /opt/energetica-whatsapp/swile_provisions.py
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/energetica-whatsapp/swile
