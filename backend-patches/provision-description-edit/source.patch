+                or any(not isinstance(row, dict) or not {'Id', *CHILD_FIELDS} <= row.keys() for row in rows)
+                or len({_identity(row['Id']) for row in rows}) != len(rows)):
+            raise RuntimeError('A relação completa das provisões não foi confirmada.')
+        if any(_identity(row.get('DESCRITIVOPROVISAO')) != parent_id for row in rows):
+            raise RuntimeError('Uma provisão foi vinculada a outro descritivo.')
+        declared_pending = source.get('PENDING CHILD IDS')
+        actual_pending = {_identity(row['Id']) for row in rows if _pending(row)}
+        if (not isinstance(declared_pending, list)
+                or len({_identity(ident) for ident in declared_pending}) != len(declared_pending)
+                or {_identity(ident) for ident in declared_pending} != actual_pending):
+            raise RuntimeError('A relação de provisões pendentes está incompleta ou contraditória.')
+        if not _same('VALORTOTAL', group['parent'].get('VALORTOTAL'), source.get('VALORTOTAL')):
+            actual_total = provision_money(_sum(provision_line_total({**row, 'FRETE': row.get('FRETE') or '0'}) for row in rows))
+            if not _same('VALORTOTAL', source.get('VALORTOTAL'), actual_total):
+                raise RuntimeError('O valor total editado ainda não corresponde aos valores persistidos nas provisões.')
+        # The existing editor confirms its fanout before returning. Also reject
+        # a partial fanout at this independent read boundary, including Cancel.
+        for field in ('FILIAL', 'FORNECEDOR', 'DATA PREVISTO PGTO', 'DATA PGTO EFETUADO', 'FORMAPGTO', 'OBS',
+                      'PGTOAGENDADO', 'STATUS', 'DATAPGTOAGENDADO', 'DATAEXECUCAOAGENDAMENTO'):
+            if not _same(field, group['parent'].get(field), source.get(field)):
+                if field == 'FORNECEDOR' and _text(source.get(field)).upper() == 'DIVERSOS':
+                    continue
+                if field not in source or any(field not in row for row in rows):
+                    raise RuntimeError('A leitura da coluna ' + field + ' não foi confirmada em todas as provisões.')
+                if any(not _same(field, source.get(field), row.get(field)) for row in rows):
+                    raise RuntimeError('A sincronização da coluna ' + field + ' ainda não foi confirmada em todas as provisões.')
+        working = copy.deepcopy(state)
+        working['navigation_history'] = []
+        working.pop('edit_step_indices', None)
+        for key in ('existing_attachments', 'existing_attachments_target', 'existing_attachments_error', 'option_pagination'):
+            working.pop(key, None)
+        if not any(_pending(row) for row in rows):
+            working['description_parent_edit_receipt'] = {
+                'batch_id': state['batch_id'], 'parent_id': parent_id,
+                'token': group['parent_editor']['token']}
+            working.pop('provision_description', None)
+            for key in ('fields', 'answers', 'selections', 'display_values', 'sharepoint'):
+                working[key] = {}
+            working.update(stage='selecting_fields', step_index=0, options=[])
+        else:
+            self._description_start(working, copy.deepcopy(source))
+            refreshed = working['provision_description']
+            old_rows = {str(row['Id']): row for row in group['original_children']}
+            old_entries = {str(entry['fields']['ID PROVISÃO']): entry['fields'] for entry in group['entries']}
+            for entry in refreshed['entries']:
+                ident = entry['fields']['ID PROVISÃO']
