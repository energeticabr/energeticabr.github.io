+            if len(values) > 1:
+                raise RuntimeError('O tipo de despesa do produto precisa ser definido antes da baixa.')
+            entry['fields']['TIPO DESPESA'] = values[0] if values else None
+
+    def _description_sync_launch_settings(self, group):
