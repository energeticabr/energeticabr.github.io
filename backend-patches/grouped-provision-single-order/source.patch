+            lines.append(f"PROVISÃO {fields['ID PROVISÃO']} — {_text(fields.get('PRODUTO'))} — "
+                         f"QTD {_text(fields.get('QTD'))} — TOTAL {_currency(amount)}")
+        if any(_text(entry['fields'].get('IDLANCAMENTOS')) for entry in group['entries']):
+            lines.append('ATENÇÃO: HÁ LANÇAMENTOS VINCULADOS. SIM EXIGE A SENHA PARA SUBSTITUÍ-LOS.')
+        lines.append('DESEJA ADICIONAR TODAS ESTAS LINHAS EM LANÇAMENTOS? '
+                     'SERÁ UTILIZADO UM ÚNICO PEDIDO PARA ESTE DESCRITIVO.')
+        return '\n'.join(lines)
