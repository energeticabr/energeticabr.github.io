+    @staticmethod
+    def _restricted_provision_branch_step(state: dict, step: dict) -> bool:
+        return (
+            state.get("flow") in {
+                "payment", "payment_provision_edit", "payment_settlement"
+            }
+            and step.get("target_field") == "FILIAL"
+            and step.get("kind") == "selection"
+        )
+
+    def _allowed_provision_branch_options(self, options: list[dict]) -> list[dict]:
+        return [
+            item for item in options
+            if self._launch_branch_code(item.get("value")) in {"000", "004"}
+        ]
