+"""Exact, presentation-only projection of a grouped settlement draft."""
+from decimal import Decimal
+
+try:
+    from .payment_provision_group import _number, _currency, _canonical, _sum, provision_line_total
+except ImportError:
+    from payment_provision_group import _number, _currency, _canonical, _sum, provision_line_total
+
+
+def unit_display(value):
+    text = format(Decimal(_canonical(value)), ',f').translate(str.maketrans({',': '.', '.': ','}))
+    whole, separator, fraction = text.partition(',')
+    return 'R$ ' + whole + ',' + fraction.ljust(2, '0')
+
+
+def review_table(group):
+    entries = {str(entry['fields']['ID PROVISÃO']): entry['fields']
+               for entry in group.get('entries') or []}
+    pending = {str(row['Id']) for row in group['children']}
+    rows, totals, pending_totals = [], [], []
+    valid_total = valid_pending = True
+    for index, original in enumerate(sorted(group['original_children'], key=lambda row: int(row['Id'])), 1):
+        item_id = str(original['Id'])
+        fields = entries.get(item_id, original)
+        values = {}
+        for field in ('QTD', 'VALOR TOTAL', 'FRETE'):
+            raw = fields.get(field)
+            if field == 'FRETE' and raw in (None, ''):
+                raw = '0'
+            try:
+                values[field] = _number(raw, field, positive=(field == 'QTD'
+                    or (field == 'VALOR TOTAL' and item_id in pending)))
+            except ValueError:
+                values[field] = None
+        amount = None
+        if all(value is not None for value in values.values()):
+            amount = provision_line_total(values)
+            totals.append(amount)
+            if item_id in pending:
+                pending_totals.append(amount)
+        else:
+            valid_total = False
+            if item_id in pending:
+                valid_pending = False
+        quantity, unit, freight = (values[field] for field in ('QTD', 'VALOR TOTAL', 'FRETE'))
+        rows.append({'id': item_id, 'index': index,
+            'product': str(fields.get('PRODUTO') or 'EM BRANCO'),
+            'quantityDisplay': _canonical(quantity).replace('.', ',') if quantity is not None else 'PENDENTE',
+            'unitPriceDisplay': unit_display(unit) if unit is not None else 'PENDENTE',
+            'totalDisplay': _currency(amount) if amount is not None else 'PENDENTE',
+            'freightDisplay': _currency(freight) if freight else '',
+            'paid': item_id not in pending})
+    return {'kind': 'provision_settlement_review', 'descriptionId': str(group['parent_id']),
+        'title': f"DETALHAMENTO — DESCRITIVO {group['parent_id']}",
+        'notice': '' if valid_total and valid_pending else
+            'PREENCHA OS VALORES PENDENTES EM EDITAR ALGUMA LINHA ANTES DE SUBMETER.',
+        'rows': rows, 'totalDisplay': _currency(_sum(totals)) if valid_total else 'VALOR PENDENTE',
+        'pendingTotalDisplay': _currency(_sum(pending_totals)) if valid_pending else 'VALOR PENDENTE',
+        'hasPaidRows': any(row['paid'] for row in rows),
+        'canSubmit': bool(pending) and valid_total and valid_pending}
