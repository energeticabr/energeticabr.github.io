+    def _resume_demonstrative_with_registered_activity(
+        self, state: dict, etag: str | None, item_id
+    ) -> dict:
+        """Seleciona a atividade confirmada e continua o demonstrativo pausado."""
+        embedded = state.get("embedded_return") or {}
+        if embedded.get("type") != "demonstrative_activity_registration":
+            raise RuntimeError("Retorno do cadastro de atividade não encontrado")
+        child_fields = state.get("fields", {})
+        activity = child_fields.get("ATIVIDADEEXECUTADA")
+        parent = copy.deepcopy(embedded["state"])
+        if not str(activity or "").strip():
+            raise RuntimeError("A atividade cadastrada não possui ATIVIDADEEXECUTADA")
+        if any(child_fields.get(field) != parent.get("fields", {}).get(field)
+               for field in ("FILIAL", "ETAPA")):
+            raise RuntimeError("A filial e a etapa da atividade diferem do demonstrativo")
+        selected = {
+            "id": item_id,
+            "title": str(activity),
+            "value": activity,
+            "source_values": {
+                "Id": item_id,
+                "ATIVIDADEEXECUTADA": activity,
+                "FILIAL": child_fields.get("FILIAL"),
+                "ETAPA": child_fields.get("ETAPA"),
+            },
+        }
+        processed = list(state.get("processed_message_ids", []))
+        state.update(parent)
+        state["processed_message_ids"] = processed
+        state["stage"] = "selecting_fields"
+        state["options"] = []
+        if "embedded_return" not in parent:
+            state.pop("embedded_return", None)
+        if "idempotency_token" not in parent:
+            state.pop("idempotency_token", None)
+        for transient in ("completion_trigger_message_id", "submission_failure",
+                          "summary_card", "option_pagination"):
+            state.pop(transient, None)
+        self._apply_selected_option(state, self._current_step(state), selected)
+        result = self._prompt_next_or_summary(state, etag)
+        return {
+            **result,
+            "embedded_demonstrative_activity_registered": True,
+            "registered_activity_item_id": item_id,
         }
 
