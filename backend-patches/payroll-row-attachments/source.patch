--- /dev/null
+++ b/worker/payroll_row_attachments.py
@@ -0,0 +1,108 @@
+"""Settlement-only child -> own launch + shared order attachment propagation.
+
+No financial creation, parent enumeration, scheduler or persistent sync state.
+"""
+try:
+    from .provision_attachment_sync import SharePointStore, copy_name, item_id, sha
+except ImportError:
+    from provision_attachment_sync import SharePointStore, copy_name, item_id, sha
+
+CHILD = 'PROVISÃO PGTOS'
+LAUNCH = 'LANCAMENTOS'
+ORDER = 'NOTASPENDENTES'
+
+
+def _text(value):
+    return '' if value is None else str(value).strip()
+
+
+def _verified(value):
+    return value is True or (isinstance(value, dict) and value.get('fields') is True
+                             and value.get('attachments') is True)
+
+
+def propagate(client, child, expected, record, parent=None):
+    """Use settlement-confirmed IDs, then revalidate live links before copying.
+
+    Before the conditional paid write, expected contains the original child
+    links. On journal recovery it contains the already-paid expected links.
+    """
+    child = item_id(child)
+    launch, order = record.get('launch_item'), record.get('related_item')
+    if not launch and not order:
+        return []
+    if not launch or not order:
+        raise RuntimeError('Vínculos incompletos para os anexos da baixa.')
+    launch_id, order_id = item_id(launch['item_id']), item_id(order['item_id'])
+    if (launch.get('target_list') != LAUNCH or order.get('target_list') != ORDER
+            or not _verified(launch.get('verified')) or not _verified(order.get('verified'))):
+        raise RuntimeError('Destinos da baixa não confirmados para anexos.')
+    source_fields = ['FORNECEDOR', 'FILIAL', 'IDPEDIDO', 'IDLANCAMENTOS', 'DESCRITIVOPROVISAO']
+    source, version = client.get_item_fields_with_etag(child, source_fields, target_list=CHILD)
+    for key in ('FORNECEDOR', 'FILIAL'):
+        if not _text(expected.get(key)):
+            raise RuntimeError('Fornecedor/filial ausente na origem dos anexos.')
+    old_links = tuple(_text(expected.get(key)) for key in ('IDPEDIDO', 'IDLANCAMENTOS'))
+    actual_links = tuple(_text(source.get(key)) for key in ('IDPEDIDO', 'IDLANCAMENTOS'))
+    if actual_links not in {old_links, (str(order_id), str(launch_id))}:
+        raise RuntimeError('Vínculos financeiros da provisão divergentes.')
+    for key in ('FORNECEDOR', 'FILIAL', 'DESCRITIVOPROVISAO'):
+        wanted = parent if key == 'DESCRITIVOPROVISAO' and parent is not None else expected.get(key)
+        if _text(source.get(key)) != _text(wanted):
+            raise RuntimeError('Vínculo da provisão alterado antes da cópia de anexos.')
+
+    launch_fields = {key: source[key] for key in ('FORNECEDOR', 'FILIAL')}
+    launch_fields.update({'IDPGTOAGENDADO': str(child), 'AGRUPAR': str(order_id)})
+    order_fields = {key: source[key] for key in ('FORNECEDOR', 'FILIAL')}
+
+    def guard():
+        current, current_version = client.get_item_fields_with_etag(child, source_fields, target_list=CHILD)
+        if current != source or current_version != version:
+            raise RuntimeError('Provisão alterada durante a cópia de anexos.')
+        for kind, target, fields in ((LAUNCH, launch_id, launch_fields), (ORDER, order_id, order_fields)):
+            if not _verified(client.verify_item(target, fields, [], target_list=kind)):
+                raise RuntimeError('Vínculo financeiro divergente durante a cópia de anexos.')
+
+    guard()
+    store = SharePointStore(client)
+    names = store.names(CHILD, child)
+    # Validate every source file and every destination inventory before writing.
+    sources = []
+    for name in sorted(names):
+        content = store.content(CHILD, child, name)
+        digest = sha(content)
+        sources.append((name, copy_name(child, digest, name), content, digest))
+    plans = []
+    for kind, target in ((LAUNCH, launch_id), (ORDER, order_id)):
+        existing = {name: store.digest(kind, target, name) for name in sorted(store.names(kind, target))}
+        for original, deterministic, content, digest in sources:
+            name = next((name for name, value in existing.items() if value == digest), deterministic)
+            if name in existing and existing[name] != digest:
+                raise RuntimeError('Conflito de conteúdo no destino; nenhum anexo foi substituído.')
+            plans.append((kind, target, original, name, content, digest, name in existing))
+            existing[name] = digest
+    guard()
+    for kind, target, original, name, content, digest, reused in plans:
+        guard()
+        if not reused:
+            try:
+                client._ensure_attachment_local(target, name, content, target_list=kind)
+            except Exception:
+                # A lost POST response is success only when the bytes survived.
+                if name not in store.names(kind, target) or store.digest(kind, target, name) != digest:
+                    raise
+        if store.digest(kind, target, name) != digest:
+            raise RuntimeError('Cópia de anexo não confirmada por SHA-256.')
+    guard()
+    if store.names(CHILD, child) != names:
+        raise RuntimeError('A coleção de anexos da provisão mudou durante a baixa.')
+    for original, deterministic, content, digest in sources:
+        if store.digest(CHILD, child, original) != digest:
+            raise RuntimeError('O conteúdo de origem mudou durante a baixa.')
+    # Confirm all destinations together, including files reused by content.
+    for kind, target, original, name, content, digest, reused in plans:
+        if store.digest(kind, target, name) != digest:
+            raise RuntimeError('O anexo de destino mudou durante a baixa.')
+    guard()
+    return [{'target_list': kind, 'item_id': target, 'source': original,
+             'name': name, 'sha256': digest} for kind, target, original, name, content, digest, reused in plans]
