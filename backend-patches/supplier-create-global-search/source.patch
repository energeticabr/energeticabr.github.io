+    def _resume_origin_with_registered_supplier(
+        self, state: dict, etag: str | None, item_id
+    ) -> dict:
+        """Retoma a despesa ou o agrupamento, sem modificar as linhas do lote."""
+        embedded = state.get("embedded_return") or {}
+        return_type = embedded.get("type")
+        if return_type not in {
+            "recurring_expense_supplier_registration",
+            "multi_launch_grouping_supplier_registration",
+        }:
+            raise RuntimeError("Retorno do cadastro de fornecedor não encontrado")
+        supplier = state.get("fields", {}).get("CADASTRO")
+        if not str(supplier or "").strip():
+            raise RuntimeError("O fornecedor cadastrado não possui CADASTRO")
+        parent = copy.deepcopy(embedded["state"])
+        processed = list(state.get("processed_message_ids", []))
+        state.update(parent)
+        state["processed_message_ids"] = processed
+        if "embedded_return" not in parent:
+            state.pop("embedded_return", None)
+        for transient in ("idempotency_token", "completion_trigger_message_id",
+                          "submission_failure", "summary_card", "option_pagination"):
+            state.pop(transient, None)
+        state["registered_supplier"] = {"item_id": item_id, "supplier": supplier}
+        state["stage"] = "selecting_fields"
+        state["options"] = []
+        if return_type == "multi_launch_grouping_supplier_registration":
+            state["multi_launch_grouping_supplier"] = supplier
+            state.setdefault("answers", {})["fornecedor_agrupador_lancamento"] = supplier
+            state.setdefault("display_values", {})["FORNECEDOR AGRUPADOR DO PEDIDO"] = str(supplier)
+        else:
+            steps = self._flow_config(state)["steps"]
+            index, step = next((i, step) for i, step in enumerate(steps)
+                               if step["key"] == "fornecedor_despesa_recorrente")
+            state["step_index"] = index
+            self._apply_selected_option(state, step, {
+                "id": item_id, "title": str(supplier), "value": supplier,
+            })
+        result = self._prompt_next_or_summary(state, etag)
+        return {**result, "embedded_supplier_registered": True,
+                "registered_supplier_item_id": item_id}
 
