[Unit]
Description=Energetica - vincular PDFs Asaas Silva Novais por vencimento
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=energetica-whatsapp
Group=energetica-whatsapp
WorkingDirectory=/opt/energetica-whatsapp/cemig-provisions
EnvironmentFile=/etc/energetica-whatsapp.env
ExecStart=/opt/energetica-whatsapp/.venv/bin/python /opt/energetica-whatsapp/cemig-provisions/silva_novais.py
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/energetica-whatsapp
MemoryMax=500M

