+            _fail("schema_missing", "O campo VALORTOTAL de Notas Pendentes não está disponível para gravação.", 503)
+        for attempt in range(3):
+            try:
+                order = self._get(ORDERS, order_id, fields)
+                etag = self._etag(order)
+                rows = dict(self._order_links(order_id, amounts=True))
+                # The group query must already reflect the committed edit or
+                # removal. Allow only negligible precision loss in list numbers.
+                expected = rows.get(required_launch)
+                if ((required_launch is not None and (expected is None or
+                        (saved_amount is not None and abs(expected - saved_amount) > Decimal("0.000000001"))))
+                        or absent_launch in rows or (require_rows and not rows)):
+                    continue
+                total = sum(rows.values(), Decimal(0)).quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)
+                values = {"VALORTOTAL": format(total, ".2f").replace(".", ",")}
+                note = self._order_adjustment_note(order.get("OBS"), total)
+                if note != order.get("OBS"):
+                    values["OBS"] = note
+                # Even an unchanged sum uses the version check: a concurrent
+                # edit holding this older ETag must recalculate before writing.
