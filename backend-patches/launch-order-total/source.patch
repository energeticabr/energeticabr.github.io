+                             "Content-Type": "application/json;odata=nometadata"})
+                confirmed = self._get(ORDERS, order_id, fields)
+                if (not _blank(confirmed.get("VALORTOTAL"))
+                        and _number(confirmed["VALORTOTAL"]) == total
+                        and ("OBS" not in values or confirmed.get("OBS") == values["OBS"])):
+                    return
+            except requests.RequestException as exc:
+                status = getattr(getattr(exc, "response", None), "status_code", None)
+                if attempt == 2 or (status not in (409, 412, 429, 500, 502, 503, 504)
+                                    and not isinstance(exc, (requests.Timeout, requests.ConnectionError))):
