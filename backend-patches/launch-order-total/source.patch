+        if failed:
+            orders = ", ".join(f"#{order_id}" for order_id in failed)
+            _fail("order_total_incomplete",
+                  f"O lançamento foi salvo, mas o total em Notas Pendentes não foi confirmado para {orders}. "
+                  "Atualize a galeria e confira o pedido antes de repetir a edição.",
+                  502, launchUpdated=True, orderIds=failed)
+
+    @staticmethod
+    def _order_adjustment_note(note, net):
+        # Generated notes describe an adjustment already allocated in the saved
+        # line prices. Keep its amount, recompute only gross/net, and retain all
+        # user text outside the single recognized block.
+        if not isinstance(note, str):
+            return note
+        matches = list(ORDER_ADJUSTMENT_NOTE.finditer(note))
+        if len(matches) != 1:
+            return note
+        match = matches[0]
+        try:
+            adjustment = _number(match["adjustment"])
+            if match["kind"] != "DESCONTO":
+                adjustment = -abs(adjustment)
+            if (_number(match["gross"]) - adjustment != _number(match["net"])
+                    or not adjustment):
+                return note
+        except LaunchGalleryError:
+            return note
+
+        def display(amount):
+            rendered = f"{amount:,.2f}".replace(",", "_").replace(".", ",").replace("_", ".")
+            return f"R$ {rendered}"
+
+        result = note
+        for name, amount in (("net", net), ("gross", net + adjustment)):
+            start, end = match.span(name)
+            result = result[:start] + display(amount) + result[end:]
+        return result
+
+    def _sync_order_total(self, order_id, *, required_launch=None, saved_amount=None,
