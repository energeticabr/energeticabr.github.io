+def provision_due_date(raw):
+    """Read a calendar date without moving it across time zones."""
+    if isinstance(raw, datetime):
+        return raw.date()
+    if isinstance(raw, date):
+        return raw
+    if not isinstance(raw, str) or not raw.strip():
+        return None
+    text = raw.strip()
+    try:
+        if re.fullmatch(r"\d{2}/\d{2}/\d{4}", text):
+            return datetime.strptime(text, "%d/%m/%Y").date()
+        if re.fullmatch(r"\d{4}-\d{2}-\d{2}", text):
+            return date.fromisoformat(text)
+        if re.match(r"^\d{4}-\d{2}-\d{2}[T ]", text):
+            return datetime.fromisoformat(text.replace("Z", "+00:00")).date()
+    except ValueError:
+        pass
+    return None
+
+
+def provision_child_is_paid(fields):
+    """Payment requires a valid actual date plus the existing paid evidence."""
+    actual = _field(fields, "DATA PGTO EFETUADO", "DATAPGTOEFETUADO")
+    return provision_due_date(actual) is not None and (
+        str(fields.get("PGTOAGENDADO") or "").strip().casefold() == "pago"
+        or str(fields.get("STATUS") or "").strip().casefold() == "pagamento efetuado")
+
+
+def earliest_unpaid_due(children):
+    """Every not-proven-paid child counts; unknown unpaid due dates fail closed."""
+    dates = []
+    for fields in children:
+        if provision_child_is_paid(fields):
+            continue
+        due = provision_due_date(_field(fields, "DATA PREVISTO PGTO", "DATAPREVISTOPGTO"))
+        if due is None:
+            raise ValueError("Data prevista ausente ou inválida em uma provisão não comprovadamente paga")
+        dates.append(due)
+    return min(dates).isoformat() if dates else None
+
