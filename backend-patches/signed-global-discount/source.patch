+def parse_global_discount(raw, *, allow_zero=False, allow_fractional_positive=False):
+    """Signed BRL adjustment only: a negative discount increases the total."""
+    if isinstance(raw, str):
+        text = raw.strip().replace("\u00a0", "").replace(" ", "")
+        if text[:2].lower() == "r$":
+            text = text[2:]
+        sign = "-" if text.startswith("-") else ""
+        unsigned = text[1:] if sign else text
+        if "," in unsigned and "." in unsigned and unsigned.rfind(".") > unsigned.rfind(","):
+            if not re.fullmatch(r"(?:[0-9]+|[0-9]{1,3}(?:,[0-9]{3})+)\.[0-9]+", unsigned):
+                raise ValueError("Invalid provision number: DESCONTO GLOBAL")
+            unsigned = unsigned.replace(",", "")
+        raw = sign + unsigned
+    value = _number(raw, "DESCONTO GLOBAL", allow_negative=True)
+    if (not allow_zero and value == 0) or (
+            value != provision_money(value) and not (allow_fractional_positive and value > 0)):
+        raise ValueError("Informe um desconto ou acréscimo em reais, com no máximo duas casas decimais")
+    return value
