+"""Single-POST supplier registration, durable even if its response is lost."""
+import hashlib
+import json
+import re
+import secrets
+
+try:
+    from .contractor_employment import SOURCE, JSON_HEADERS, collection, _positive_id, _state_directory, _checkpoint, supplier_lock
+except ImportError:
+    from contractor_employment import SOURCE, JSON_HEADERS, collection, _positive_id, _state_directory, _checkpoint, supplier_lock
