+"""Exact list ACL mirror; never resolve principals, elevate scope, or copy data."""
+import hashlib
+import json
+
+import requests
+
+SOURCE = 'FORNECEDORES'
+TARGET = 'FUNCIONARIOSRH'
+HEADERS = {'Content-Type': 'application/json;odata=nometadata'}
+
+
+def _request(client, method, endpoint, **kwargs):
+    try:
+        return client._request(method, endpoint, **kwargs)
+    except requests.HTTPError as error:
+        if error.response is not None and error.response.status_code in (401, 403):
+            raise PermissionError('Existing ManagePermissions access required; no elevation attempted') from None
+        raise
+
+
+def _roles(client, title):
+    try:
+        from .contractor_employment import collection
+    except ImportError:
+        from contractor_employment import collection
+    try:
+        rows = collection(client, client._list_endpoint(title) + '/roleassignments', {
+            '$select': 'PrincipalId,RoleDefinitionBindings/Id',
+            '$expand': 'RoleDefinitionBindings', '$top': '5000'})
+    except requests.HTTPError as error:
+        if error.response is not None and error.response.status_code in (401, 403):
+            raise PermissionError('Permission metadata unavailable; no elevation attempted') from None
+        raise
+    roles = {}
+    for row in rows:
+        principal = row.get('PrincipalId')
+        bindings = row.get('RoleDefinitionBindings')
+        bindings = bindings.get('results') if isinstance(bindings, dict) else bindings
+        if type(principal) is not int or principal <= 0 or not isinstance(bindings, list) or not bindings:
+            raise PermissionError('Incomplete permission metadata')
+        ids = [r.get('Id') for r in bindings if isinstance(r, dict)]
+        if len(ids) != len(bindings) or any(type(i) is not int or i <= 0 for i in ids):
+            raise PermissionError('Incomplete permission metadata')
+        roles.setdefault(principal, set()).update(ids)
+    return {p: sorted(ids) for p, ids in sorted(roles.items())}
+
+
+def read_acl(client, title):
+    payload = _request(client, 'GET', client._list_endpoint(title), params={
+        '$select': 'HasUniqueRoleAssignments,ReadSecurity,WriteSecurity'})
+    value = payload.get('d', payload)
+    if type(value.get('HasUniqueRoleAssignments')) is not bool:
+        raise PermissionError('Permission inheritance metadata unavailable')
+    if type(value.get('ReadSecurity')) is not int or value['ReadSecurity'] not in (1, 2):
+        raise PermissionError('ReadSecurity metadata unavailable')
+    if type(value.get('WriteSecurity')) is not int or value['WriteSecurity'] not in (1, 2, 4):
+        raise PermissionError('WriteSecurity metadata unavailable')
+    return {'unique': value['HasUniqueRoleAssignments'], 'read': value['ReadSecurity'],
+            'write': value['WriteSecurity'], 'roles': _roles(client, title)}
+
+
+def acl_hash(acl):
+    payload = {'read': acl['read'], 'write': acl['write'],
+               'roles': [[p, ids] for p, ids in sorted(acl['roles'].items())]}
+    return hashlib.sha256(json.dumps(payload, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
+
+
+def equivalent(source, target):
+    return (not source['unique'] or target['unique']) and acl_hash(source) == acl_hash(target)
+
+
+def verify_mirror_permissions(client, *, allow_own_items=False):
+    source, target = read_acl(client, SOURCE), read_acl(client, TARGET)
+    if not equivalent(source, target):
+        raise PermissionError('Mirror permission boundary differs from source; copying refused')
+    if not allow_own_items and (source['read'] == 2 or source['write'] == 2):
+        raise PermissionError('Own-item permissions require native source authorship; copying refused')
+    return acl_hash(source)
+
+
+def require_inherited_item(item):
+    if item.get('HasUniqueRoleAssignments') is not False:
+        raise PermissionError('Unique or unknown item permissions; copying refused')
+
+
+def mirror_permissions(client, *, source=None):
+    source = source if source is not None else read_acl(client, SOURCE)
+    target = read_acl(client, TARGET)
+    endpoint = client._list_endpoint(TARGET)
+    if equivalent(source, target):
+        if acl_hash(read_acl(client, SOURCE)) != acl_hash(source):
+            raise PermissionError('Source permissions changed during provisioning')
+        return acl_hash(source)
+    if not target['unique'] and (source['unique'] or target['roles'] != source['roles']):
+        # Preserve existing inherited bindings. copy=false would implicitly
+        # introduce caller Full Control before any fallible grant/cleanup.
+        _request(client, 'POST', endpoint + '/breakroleinheritance(copyRoleAssignments=true,clearSubscopes=false)')
+        target = read_acl(client, TARGET)
+    if (target['read'], target['write']) != (source['read'], source['write']):
+        _request(client, 'POST', endpoint, json={'ReadSecurity': source['read'], 'WriteSecurity': source['write']},
+            headers={**HEADERS, 'IF-MATCH': '*', 'X-HTTP-Method': 'MERGE'})
+    # Only source recipients/role IDs may be added. Inherited extras remain
+    # unchanged until grants succeed, then are removed before data is allowed.
+    for principal, roles in source['roles'].items():
+        for role in roles:
+            if role not in target['roles'].get(principal, []):
+                _request(client, 'POST', endpoint +
+                    f'/roleassignments/addroleassignment(principalid={principal},roledefid={role})')
+    for principal, roles in target['roles'].items():
+        for role in roles:
+            if role not in source['roles'].get(principal, []):
+                _request(client, 'POST', endpoint +
+                    f'/roleassignments/removeroleassignment(principalid={principal},roledefid={role})')
+    latest_source, latest_target = read_acl(client, SOURCE), read_acl(client, TARGET)
+    if acl_hash(latest_source) != acl_hash(source) or not equivalent(latest_source, latest_target):
+        raise PermissionError('Permission mirror not confirmed; no data may be copied')
+    return acl_hash(latest_source)
