+"""Additive FORNECEDORES mirror. Never log supplier fields or invent dates.
+
+Writes deliberately bypass ensure_item/_target_payload: those helpers coerce
+null Text values and cannot persist an uncertain-create checkpoint for us.
+"""
+from contextlib import contextmanager
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import tempfile
+import time
+from urllib.parse import quote, unquote, urljoin, urlsplit
+from xml.etree import ElementTree as ET
+
+import requests
+
+try:
+    from .contractor_permissions import verify_mirror_permissions, require_inherited_item
+except ImportError:
+    from contractor_permissions import verify_mirror_permissions, require_inherited_item
+
+SOURCE = 'FORNECEDORES'
+TARGET = 'FUNCIONARIOSRH'
+KEY = 'IDFORNECEDORORIGEM'
+DATES = ('DATAADMISSAO', 'DATADESLIGAMENTO')
+AUDIT = {'ORIGEMCRIADOEM': 'DateTime', 'ORIGEMMODIFICADOEM': 'DateTime',
+         'ORIGEMAUTORJSON': 'Note', 'ORIGEMEDITORJSON': 'Note', 'ORIGEMSNAPSHOTJSON': 'Note'}
+SYSTEM = {'ID', 'Id', 'Author', 'Editor', 'Created', 'Modified', 'Attachments',
+          'ContentType', 'ContentTypeId', 'GUID', 'FileSystemObjectType'}
+JSON_HEADERS = {'Content-Type': 'application/json;odata=nometadata'}
+
+
+def _positive_id(value):
+    if isinstance(value, bool) or not isinstance(value, (int, str)) or not re.fullmatch(r'[1-9][0-9]*', str(value)):
+        raise ValueError('Invalid supplier ID')
+    return int(value)
+
+
+def collection(client, endpoint, params=None):
+    """Read every page, accepting only continuations of this exact collection."""
+    original = urljoin(client.site_url.rstrip('/') + '/_api/', endpoint)
+    expected = urlsplit(original)
+    allowed = (expected.scheme, expected.netloc, unquote(expected.path).casefold())
+    seen, result = set(), []
+    url = original
+    while url:
+        parsed = urlsplit(url)
+        if (parsed.scheme, parsed.netloc, unquote(parsed.path).casefold()) != allowed or parsed.fragment:
+            raise ValueError('Unexpected SharePoint continuation')
+        if url in seen or len(seen) >= 10000:
+            raise ValueError('Repeated or excessive SharePoint continuation')
+        seen.add(url)
+        payload = client._request('GET', url, params=params)
+        params = None
+        data = payload.get('d', {}) if isinstance(payload, dict) else {}
+        rows = payload.get('value', data.get('results')) if isinstance(payload, dict) else None
+        if not isinstance(rows, list) or any(not isinstance(row, dict) for row in rows):
+            raise ValueError('Incomplete SharePoint collection')
+        result.extend(rows)
+        links = [payload.get('@odata.nextLink'), payload.get('odata.nextLink'), data.get('__next')]
+        links = [link for link in links if link not in (None, '')]
+        if any(not isinstance(link, str) for link in links) or len(set(links)) > 1:
+            raise ValueError('Invalid SharePoint continuation')
+        url = urljoin(original, links[0]) if links else None
+    return result
+
+
+def list_fields(client, title):
+    return collection(client, client._list_endpoint(title) + '/fields', {
+        '$select': 'InternalName,Title,TypeAsString,ReadOnlyField,Hidden,Required,SchemaXml,Indexed,EnforceUniqueValues',
+        '$top': '5000'})
+
+
+def business_fields(fields):
+    return [f for f in fields if not f.get('ReadOnlyField') and not f.get('Hidden')
+            and f['InternalName'] not in SYSTEM
+            and f['TypeAsString'] not in {'Computed', 'Attachments', 'Counter', 'ContentTypeId'}]
+
+
+def validate_field(actual, expected):
+    name = expected['InternalName']
+    if actual['TypeAsString'] != expected['TypeAsString'] or actual.get('ReadOnlyField'):
+        raise ValueError(f'Incompatible field type: {name}')
+    if name == KEY and not (actual.get('Indexed') is True and actual.get('EnforceUniqueValues') is True):
+        raise ValueError('Source identity must be unique and indexed')
+    if name in DATES:
+        xml = ET.fromstring(actual['SchemaXml'])
+        if xml.get('Format', '').casefold() != 'dateonly':
+            raise ValueError(f'Expected date-only field: {name}')
+
+
+def expected_field(name, kind, **attributes):
+    node = ET.Element('Field', {'Name': name, 'StaticName': name, 'DisplayName': name,
+        'Type': kind, 'Required': 'FALSE', **attributes})
+    return {'InternalName': name, 'Title': name, 'TypeAsString': kind,
+            'SchemaXml': ET.tostring(node, encoding='unicode')}
+
+
+def additional_fields():
+    return [expected_field(KEY, 'Text', Indexed='TRUE', EnforceUniqueValues='TRUE'),
+            *(expected_field(n, 'DateTime', Format='DateOnly') for n in DATES),
+            *(expected_field(n, t, **({'RichText': 'FALSE', 'UnlimitedLengthInDocumentLibrary': 'TRUE'} if t == 'Note' else {}))
+              for n, t in AUDIT.items())]
+
+
+def _state_directory(client, state_store):
+    base = getattr(state_store, 'directory', None) or os.getenv('CONTRACTOR_EMPLOYMENT_STATE_DIR')
+    if base is None:
+        base = '/var/lib/energetica-whatsapp/state'
+    site = hashlib.sha256(client.site_url.rstrip('/').casefold().encode()).hexdigest()[:20]
+    directory = Path(base).resolve() / 'contractor-employment-register' / site
+    directory.mkdir(parents=True, mode=0o700, exist_ok=True)
+    if directory.is_symlink() or not directory.is_dir():
+        raise RuntimeError('Invalid mirror state directory')
+    return directory
+
+
+@contextmanager
+def supplier_lock(directory, source_id):
+    """Same persistent inode across services, including services using PrivateTmp."""
+    descriptor = os.open(directory / f'{source_id}.lock',
+        os.O_RDWR | os.O_CREAT | getattr(os, 'O_NOFOLLOW', 0), 0o600)
+    acquired = False
+    try:
+        if os.fstat(descriptor).st_size == 0:
+            os.write(descriptor, b'0')
+        deadline = time.monotonic() + 30
+        while not acquired:
+            try:
+                if os.name == 'nt':
+                    import msvcrt
+                    os.lseek(descriptor, 0, os.SEEK_SET)
+                    msvcrt.locking(descriptor, msvcrt.LK_NBLCK, 1)
+                else:
+                    import fcntl
+                    fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                acquired = True
+            except (BlockingIOError, OSError):
+                if time.monotonic() >= deadline:
+                    raise TimeoutError('Mirror reconciliation already running') from None
+                time.sleep(.05)
+        yield
+    finally:
+        if acquired:
+            if os.name == 'nt':
+                import msvcrt
+                os.lseek(descriptor, 0, os.SEEK_SET)
+                msvcrt.locking(descriptor, msvcrt.LK_UNLCK, 1)
+            else:
+                import fcntl
+                fcntl.flock(descriptor, fcntl.LOCK_UN)
+        os.close(descriptor)
+
+
+def _checkpoint(path, state):
+    descriptor, temporary = tempfile.mkstemp(prefix='.checkpoint-', dir=path.parent)
+    try:
+        with os.fdopen(descriptor, 'w', encoding='utf-8') as stream:
+            json.dump(state, stream)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, path)
+        if os.name != 'nt':
+            descriptor = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
+            try:
+                os.fsync(descriptor)
+            finally:
+                os.close(descriptor)
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+def _item(payload):
+    return payload.get('d', payload)
+
+
+def _versioned_item(client, title, item_id, *, params=None):
+    response = client._request('GET', client._list_endpoint(title) + f'/items({item_id})',
+                               params=params, _return_response=True)
+    item = _item(response.json())
+    etag = str(response.headers.get('ETag') or item.get('@odata.etag')
+               or item.get('odata.etag') or item.get('__metadata', {}).get('etag') or '').strip()
+    if not etag or etag == '*':
+        raise RuntimeError('Item version unavailable; reconciliation required')
+    if _positive_id(item.get('Id', item.get('ID'))) != item_id:
+        raise RuntimeError('Unexpected item identity; reconciliation required')
+    require_inherited_item(item)
+    return item, etag
+
+
+def _assert_source_current(client, source_id, source, etag):
+    current, current_etag = _versioned_item(client, SOURCE, source_id,
+                                            params={'$select': 'Id,Modified,HasUniqueRoleAssignments'})
+    if current_etag != etag or current.get('Modified') != source.get('Modified'):
+        raise RuntimeError('Source changed during mirror copy; reconciliation required')
+
+
+def _lookup(client, source_id):
+    rows = collection(client, client._list_endpoint(TARGET) + '/items', {
+        '$filter': f"{KEY} eq '{source_id}'", '$top': '2'})
+    if len(rows) > 1:
+        raise RuntimeError('Duplicate mirror identity; manual reconciliation required')
+    return rows[0] if rows else None
+
+
+def _json(value):
+    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(',', ':'))
+
+
+def _business_payload(source, fields):
+    result = {}
+    for f in fields:
+        name, kind = f['InternalName'], f['TypeAsString']
+        if kind in {'User', 'UserMulti', 'Lookup', 'LookupMulti'}:
+            if name + 'Id' not in source and name not in source:
+                raise ValueError(f'Source response omitted business field: {name}')
+            value = source.get(name + 'Id', source.get(name))
+            if kind.endswith('Multi'):
+                values = value.get('results', []) if isinstance(value, dict) else value or []
+                value = {'results': [v['Id'] if isinstance(v, dict) else v for v in values]}
+            elif isinstance(value, dict):
+                value = value['Id']
+            result[name + 'Id'] = value
+        elif name in source:
+            result[name] = source[name]
+        else:
+            raise ValueError(f'Source response omitted business field: {name}')
+    return result
+
+
+def _attachment_names(client, title, item_id):
+    return collection(client, client._list_endpoint(title) + f'/items({item_id})/AttachmentFiles',
+                      {'$select': 'FileName', '$top': '5000'})
+
+
+def sync_supplier(client, supplier_id, *, state_store=None) -> dict:
+    return _sync_supplier(client, _positive_id(supplier_id), state_store=state_store)
+
+
+def _sync_supplier(client, source_id, *, state_store, fields=None):
+    directory = _state_directory(client, state_store)
+    with supplier_lock(directory, source_id):
+        return _sync_locked(client, source_id, directory / f'{source_id}.json', fields=fields)
+
+
+def _validated_fields(client):
+    fields = business_fields(list_fields(client, SOURCE))
+    target_fields = {f['InternalName']: f for f in list_fields(client, TARGET)}
+    for expected in [*fields, *additional_fields()]:
+        actual = target_fields.get(expected['InternalName'])
+        if actual is None:
+            raise ValueError('Mirror schema must be provisioned before synchronization')
+        validate_field(actual, expected)
+    for name in DATES:
+        source_date = next((f for f in fields if f['InternalName'] == name), None)
+        if source_date is None:
+            raise ValueError('Source dates must be provisioned before synchronization')
+        validate_field(source_date, expected_field(name, 'DateTime'))
+    return fields
+
+
+def _eligible(source):
+    return (str(source.get('EMPREITEIRO', '')).strip().upper() == 'SIM'
+            and str(source.get('STATUS', '')).strip().upper() == 'ATIVO')
+
+
+def _sync_locked(client, source_id, path, *, fields=None):
+    if fields is None:
+        fields = _validated_fields(client)
+    source, source_etag = _versioned_item(client, SOURCE, source_id,
+        params={'$select': '*,HasUniqueRoleAssignments,Author/Id,Author/Title,Author/EMail,Editor/Id,Editor/Title,Editor/EMail',
+                '$expand': 'Author,Editor'})
+    existing = _lookup(client, source_id)
+    checkpoint = json.loads(path.read_text(encoding='utf-8')) if path.exists() else {}
+    if checkpoint and checkpoint.get('phase') not in {'create_pending', 'linked', 'synced'}:
+        raise RuntimeError('Invalid mirror checkpoint')
+    if not existing and checkpoint:
+        raise RuntimeError('Mirror identity unresolved; refusing another create')
+    if not existing and not _eligible(source):
+        return {'status': 'skipped', 'supplier_id': source_id}
+    verify_mirror_permissions(client)
+    attachments = _attachment_names(client, SOURCE, source_id)
+    snapshot = {**source, 'AttachmentFiles': {'results': attachments}}
+    payload = {**_business_payload(source, fields), KEY: str(source_id),
+        'ORIGEMCRIADOEM': source.get('Created'), 'ORIGEMMODIFICADOEM': source.get('Modified'),
+        'ORIGEMAUTORJSON': _json(source.get('Author', source.get('AuthorId'))),
+        'ORIGEMEDITORJSON': _json(source.get('Editor', source.get('EditorId'))),
+        'ORIGEMSNAPSHOTJSON': _json(snapshot)}
+    if existing is None:
+        _assert_source_current(client, source_id, source, source_etag)
+        _checkpoint(path, {'phase': 'create_pending', 'supplier_id': source_id})
+        try:
+            created = _item(client._request('POST', client._list_endpoint(TARGET) + '/items',
+                json=payload, headers=JSON_HEADERS))
+            target_id = _positive_id(created['Id'])
+        except (requests.RequestException, KeyError, ValueError):
+            existing = _lookup(client, source_id)
+            if existing is None:
+                raise RuntimeError('Mirror create uncertain; reconciliation required') from None
+            target_id = _positive_id(existing['Id'])
+    else:
+        target_id = _positive_id(existing['Id'])
+    _checkpoint(path, {'phase': 'linked', 'supplier_id': source_id, 'target_id': target_id})
+    endpoint = client._list_endpoint(TARGET) + f'/items({target_id})'
+    current, target_etag = _versioned_item(client, TARGET, target_id,
+                                          params={'$select': '*,HasUniqueRoleAssignments'})
+    current.update(_business_payload(current, fields))
+    _assert_source_current(client, source_id, source, source_etag)
+    changes = {k: v for k, v in payload.items() if current.get(k) != v}
+    if changes:
+        try:
+            client._request('POST', endpoint, json=changes,
+                headers={**JSON_HEADERS, 'IF-MATCH': target_etag, 'X-HTTP-Method': 'MERGE'})
+        except requests.HTTPError as error:
+            if error.response is not None and error.response.status_code == 412:
+                raise RuntimeError('Target changed during mirror copy; reconciliation required') from None
+            raise
+    target_names = {r['FileName'] for r in _attachment_names(client, TARGET, target_id)}
+    copied = 0
+    for attachment in attachments:
+        name = attachment['FileName']
+        if name in target_names:
+            continue
+        escaped = quote(name.replace("'", "''"), safe='')
+        response = client._request('GET', client._list_endpoint(SOURCE) +
+            f"/items({source_id})/AttachmentFiles/getByFileName('{escaped}')/$value", _return_response=True)
+        try:
+            client._request('POST', endpoint + f"/AttachmentFiles/add(FileName='{escaped}')",
+                            data=response.content, headers={'Content-Type': 'application/octet-stream'})
+        except requests.RequestException:
+            if name not in {r['FileName'] for r in _attachment_names(client, TARGET, target_id)}:
+                raise RuntimeError('Attachment copy incomplete; reconciliation required') from None
+        copied += 1
+    # HasUniqueRoleAssignments must be explicitly selected on real SharePoint.
+    verified, _ = _versioned_item(client, TARGET, target_id,
+                                  params={'$select': '*,HasUniqueRoleAssignments'})
+    verified.update(_business_payload(verified, fields))
+    if any(verified.get(k) != v for k, v in payload.items()):
+        raise RuntimeError('Mirror fields not confirmed')
+    names = {r['FileName'] for r in _attachment_names(client, TARGET, target_id)}
+    if not {r['FileName'] for r in attachments}.issubset(names):
+        raise RuntimeError('Mirror attachments not confirmed')
+    verify_mirror_permissions(client)
+    _assert_source_current(client, source_id, source, source_etag)
+    _checkpoint(path, {'phase': 'synced', 'supplier_id': source_id, 'target_id': target_id})
+    return {'status': 'synced', 'supplier_id': source_id, 'target_id': target_id, 'copied': copied}
+
+
+def sync_all(client, *, state_store=None) -> dict:
+    rows = collection(client, client._list_endpoint(SOURCE) + '/items', {
+        '$select': 'Id,EMPREITEIRO,STATUS', '$top': '5000'})
+    targets = collection(client, client._list_endpoint(TARGET) + '/items', {
+        '$select': KEY, '$top': '5000'})
+    tracked = {str(row[KEY]) for row in targets if row.get(KEY) is not None}
+    counts = {'processed': 0, 'synced': 0, 'skipped': 0, 'errors': 0}
+    seen = set()
+    fields, schema_failed = None, False
+    for row in rows:
+        source_id = _positive_id(row.get('Id', row.get('ID')))
+        if source_id in seen:
+            continue
+        seen.add(source_id)
+        counts['processed'] += 1
+        if not _eligible(row) and str(source_id) not in tracked:
+            counts['skipped'] += 1
+            continue
+        try:
+            if schema_failed:
+                counts['errors'] += 1
+                continue
+            if fields is None:
+                try:
+                    fields = _validated_fields(client)
+                except Exception:
+                    schema_failed = True
+                    raise
+            # Only metadata is shared. The locked sync still reads the latest
+            # source and looks up the target identity before any item write.
+            result = _sync_supplier(client, source_id, state_store=state_store, fields=fields)
+            counts[result['status']] += 1
+        except Exception:
+            # Remote exceptions can include personal data. Counts are safe to log.
+            counts['errors'] += 1
+    return counts
