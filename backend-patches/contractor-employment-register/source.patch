+"""Timer entry point. Caller supplies the existing service environment and user."""
+import argparse
+import json
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+try:
+    from .contractor_employment import sync_all, sync_supplier
+except ImportError:
+    from contractor_employment import sync_all, sync_supplier
+
+
+def client_from_environment():
+    try:
+        from .clients import SharePointClient
+    except ImportError:
+        from clients import SharePointClient
+    return SharePointClient(os.environ['SHAREPOINT_HOST'], os.environ['SHAREPOINT_SITE_PATH'],
+        os.environ['ENTRA_TENANT_ID'], os.environ['ENTRA_CLIENT_ID'],
+        Path(os.environ['ENTRA_PRIVATE_KEY_FILE']).read_text(encoding='utf-8'),
+        Path(os.environ['ENTRA_CERTIFICATE_FILE']).read_text(encoding='utf-8'), 'FORNECEDORES')
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--supplier-id', type=int)
+    parser.add_argument('--state-directory', default=os.getenv('CONTRACTOR_EMPLOYMENT_STATE_DIR'))
+    args = parser.parse_args(argv)
+    try:
+        if not args.state_directory:
+            raise ValueError('Supply the same persistent state directory as the worker')
+        store = SimpleNamespace(directory=Path(args.state_directory))
+        client = client_from_environment()
+        if args.supplier_id is not None:
+            result = sync_supplier(client, args.supplier_id, state_store=store)
+        else:
+            result = sync_all(client, state_store=store)
+        print(json.dumps(result))
+        return 1 if result.get('errors') else 0
+    except Exception as error:
+        print(json.dumps({'status': 'error', 'type': type(error).__name__}))
+        return 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
