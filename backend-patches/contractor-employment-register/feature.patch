+    def _reassociate_supplier_hr_files(self, state, frozen_files, local_files):
+        """Bind explicit reuploads by original name AND bytes, never by arrival.
+
+        Reserve surviving exact names first, then consume each missing slot once.
+        The frozen manifest is immutable; only local references/names are rebound.
+        """
+        error = "Cadastro RH congelado: reenvie cada arquivo original com o mesmo nome e conteúdo"
+        attachments = state["attachments"]
+        if len(frozen_files) != len(local_files):
+            raise RuntimeError(error)
+        objects = [a["object_name"] for a in attachments if a.get("object_name")]
+        if len(set(objects)) != len(objects):
+            raise RuntimeError(error)
+        if len({f["filename"] for f in frozen_files}) != len(frozen_files):
+            raise RuntimeError(error)
+        signatures = [(f["original_name"], len(f["content"]), hashlib.sha256(f["content"]).hexdigest())
+                      for f in local_files]
+        def signature(frozen):
+            return (frozen.get("original_name"), frozen["size"], frozen["sha256"])
+        unused = set(range(len(local_files)))
+        bindings = {}
+        # A retained second file must not be consumed for a missing first copy.
+        for slot, frozen in enumerate(frozen_files):
+            exact = [i for i in unused if local_files[i]["filename"] == frozen["filename"]]
+            if len(exact) > 1:
+                raise RuntimeError(error)
+            if exact:
+                index = exact[0]
+                if signatures[index] != signature(frozen):
+                    raise RuntimeError(error)
+                bindings[slot] = index
+                unused.remove(index)
+        pending = set(state.get("supplier_hr_reattach_names") or [])
+        for slot, frozen in enumerate(frozen_files):
+            if slot in bindings:
+                continue
+            if frozen["filename"] not in pending:
+                raise RuntimeError(error)
+            index = next((i for i in sorted(unused) if signatures[i] == signature(frozen)), None)
+            if index is None:
+                raise RuntimeError(error)
+            bindings[slot] = index
+            unused.remove(index)
+        # Publish only after every slot, multiplicity and byte hash was checked.
+        state["attachments"] = [{**attachments[bindings[slot]], "sharepoint_name": frozen["filename"]}
+                                for slot, frozen in enumerate(frozen_files)]
+        state.pop("supplier_hr_reattach_names", None)
+        return [{**local_files[bindings[slot]], "filename": frozen["filename"]}
+                for slot, frozen in enumerate(frozen_files)]
 
