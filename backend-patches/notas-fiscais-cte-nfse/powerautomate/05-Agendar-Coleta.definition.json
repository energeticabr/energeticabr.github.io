{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    },
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "Recorrencia": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "timeZone": "E. South America Standard Time",
        "schedule": {
          "hours": [
            9,
            15,
            20
          ],
          "minutes": [
            0
          ]
        }
      },
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1
        }
      }
    }
  },
  "actions": {
    "Chave_job": {
      "type": "Compose",
      "inputs": "@concat('SEFAZ-',formatDateTime(convertTimeZone(utcNow(),'UTC','E. South America Standard Time'),'yyyy-MM-dd-HH'))",
      "runAfter": {}
    },
    "Localizar_job": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
          "connectionName": "shared_sharepointonline",
          "operationId": "HttpRequest"
        },
        "parameters": {
          "dataset": "https://energeticaltda-my.sharepoint.com/personal/bernardonotini_energeticabr_com",
          "parameters/method": "GET",
          "parameters/uri": "@concat('_api/web/lists/getbytitle(''SEFAZ_COLETA_FILA'')/items?$select=Id&$filter=JOB_KEY eq ''',outputs('Chave_job'),'''&$top=1')",
          "parameters/headers": {
            "Accept": "application/json;odata=nometadata",
            "Content-Type": "application/json;odata=nometadata"
          }
        },
        "authentication": "@parameters('$authentication')"
      },
      "runAfter": {
        "Chave_job": [
          "Succeeded"
        ]
      }
    },
    "Garantir_job": {
      "type": "If",
      "expression": {
        "equals": [
          "@length(body('Localizar_job')?['value'])",
          0
        ]
      },
      "actions": {
        "Criar_job": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest"
            },
            "parameters": {
              "dataset": "https://energeticaltda-my.sharepoint.com/personal/bernardonotini_energeticabr_com",
              "parameters/method": "POST",
              "parameters/uri": "_api/web/lists/getbytitle('SEFAZ_COLETA_FILA')/items",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata",
                "Content-Type": "application/json;odata=nometadata"
              },
              "parameters/body": "@string(setProperty(setProperty(setProperty(setProperty(setProperty(json('{}'),'Title','Coleta direta SEFAZ - emissao desde 2026-09-01'),'JOB_KEY',outputs('Chave_job')),'STATUS','PENDING'),'REQUESTED_AT',utcNow()),'START_DATE','2026-09-01T00:00:00-03:00'))"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {}
        }
      },
      "else": {
        "actions": {}
      },
      "runAfter": {
        "Localizar_job": [
          "Succeeded"
        ]
      }
    }
  },
  "outputs": {}
}
