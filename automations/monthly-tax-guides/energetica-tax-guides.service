[Unit]
Description=Solicitacoes mensais de guias INSS e FGTS
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/energetica-tax-guides
ExecStart=/opt/energetica-whatsapp/.venv/bin/python /opt/energetica-tax-guides/run.py --apply
TimeoutStartSec=900
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
